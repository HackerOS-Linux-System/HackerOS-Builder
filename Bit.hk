[package]
-> name        => hackeros-builder
-> version     => 0.6.0
-> description => Budowanie niemutowalnych obrazow Debiana (OCI/bootc-style).
-> authors     => ["HackerOS Team <hackeros068@gmail.com>"]
-> license     => MIT
-> lang        => h#

[edition]
-> edition => 2026

[layout]
-> src => src

[build]
-> link => static

[default-build]
-> profile => release

[dependencies]
-> colors       => newest
-> progress-bar => newest

[commands]
-> install-local
--> run => install -Dm755 cache/build/release/hackeros-builder /usr/local/bin/hackeros-builder
--> description => Zainstaluj zbudowana binarke do /usr/local/bin
-> selftest
--> run => sh tests/run.sh
--> description => Uruchom testy jednostkowe (tests/)
