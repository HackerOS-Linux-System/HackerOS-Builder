#[test]
fn test_pull_unknown_tag_fails_without_retry() is
    let pidf: string = start_mock(5173, "bearer")
    env_set("HACKEROS_PULL_BACKOFF_MS", "10")
    let e: string = oci::pull_and_unpack("127.0.0.1:5173/acme/none", "zz", "tok", testutil::tmpdir() + "/d", false)
    stop_mock(pidf)
    testutil::contains(e, "unexpected status code 404")
    testutil::is_true(!string_contains(e, "po 4 probach"), "404 nie jest ponawiane")
end

