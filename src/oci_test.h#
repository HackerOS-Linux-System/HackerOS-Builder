#[test]
fn test_local_archive_is_docker_save_format() is
    let root: string = testutil::tmpdir()
    testutil::put(root + "/etc/hello", "hi")
    let out: string = testutil::tmpdir() + "/c.tar"
    testutil::eq_s(oci::save_local_archive(root, "ghcr.io/michal/x", "t1", testutil::tmpdir(), out), "")
    let names: string = shell("tar --force-local -tf '" + out + "'")
    testutil::contains(names, "manifest.json")
    testutil::contains(names, ".tar.gz")
    testutil::contains(names, "sha256:")
    let man: string = shell("tar --force-local -xOf '" + out + "' manifest.json")
    testutil::contains(man, "\"RepoTags\":[\"ghcr.io/michal/x:t1\"]")
end

fn start_mock(port: int, mode: string) -> string is
    let pidf: string = testutil::tmpdir() + "/pid"
    shell("(python3 tests/mock_registry.py " + to_string(port) + " " + mode + " >/dev/null 2>&1 & echo $! > '" + pidf + "') ; sleep 1")
    return pidf
end

fn stop_mock(pidf: string) is
    shell("kill $(cat '" + pidf + "') 2>/dev/null; true")
end

fn push_pull_round_trip(port: int, mode: string) is
    let root: string = testutil::tmpdir()
    testutil::put(root + "/etc/hello", "round-trip")
    testutil::put(root + "/usr/bin/tool", "t")
    shell("chmod 4755 '" + root + "/usr/bin/tool' && ln -s /etc/hello '" + root + "/etc/lnk' && dd if=/dev/urandom of='" + root + "/big' bs=1M count=18 2>/dev/null")
    let layer: string = testutil::tmpdir() + "/l.tar.gz"
    oci::create_layer_tarball(root, layer)
    let pidf: string = start_mock(port, mode)
    let repo: string = "127.0.0.1:" + to_string(port) + "/acme/test"
    let pu: oci::PushRes = oci::build_and_push_layers([layer], repo, "v1", "tok", false)
    testutil::eq_s(pu.pu_err, "")
    let dest: string = testutil::tmpdir() + "/pulled"
    let pe: string = oci::pull_and_unpack(repo, "v1", "tok", dest, false)
    stop_mock(pidf)
    testutil::eq_s(pe, "")
    testutil::eq_s(fs_read(dest + "/etc/hello"), "round-trip")
    testutil::eq_s(fsx::readlink(dest + "/etc/lnk"), "/etc/hello")
    testutil::eq_s(fsx::stat_mode_octal(dest + "/usr/bin/tool"), "4755")
    testutil::eq_s(string_trim(shell("cmp '" + root + "/big' '" + dest + "/big' && echo same")), "same")
end

