fn prepare_dir(b: Builder) -> string is
    let e: string = fsx::remove_all(b.rb_rootfs)
    if e != "" is return "czyszczenie " + b.rb_rootfs + ": " + e end
    let m: string = fsx::mkdir_p(b.rb_rootfs)
    if m != "" is return "tworzenie " + b.rb_rootfs + ": " + m end
    return ""
end

fn run_debootstrap(b: Builder) -> string is
    let args: [string] = ["debootstrap", "--arch=" + config::effective_arch(b.rb_cfg), b.rb_cfg.cfg_release, b.rb_rootfs, config::effective_mirror(b.rb_cfg)]
    ui::debug("exec (streaming+lines): " + proc::join_args(args))
    let pre: [string] = ["I: Retrieving ", "I: Validating ", "I: Extracting ", "I: Unpacking ", "I: Configuring "]
    let r: track::TrackRes = track::run_line(proc::join_args(args), "debootstrap", 0, "operacji", pre, "debootstrap", "debootstrap")
    if r.tk_rc != 0 is
        let tail: string = if r.tk_tail == "" then "" else "\nostatnie linie debootstrap:\n" + r.tk_tail
        return "komenda \"debootstrap\" " + proc::format_args(strx::concat([], array_slice(args, 1, array_len(args)))) + " nie powiodla sie: exit status " + to_string(r.tk_rc) + tail
    end
    return ""
end

fn sudo_stub_text() -> string is
    return "#!/bin/sh\n# sudo-stub wygenerowany przez hackeros-builder.\n# Hooki pisane z myslą o normalnej maszynie uzywaja 'sudo <cmd>' -- wewnatrz\n# kontenera nspawn build jest rootem, wiec sudo jest zbedne. Ten stub\n# po prostu odpala komende bezposrednio, eliminujac \"sudo: not found\".\nexec \"$@\"\n"
end

fn install_sudo_stub(b: Builder) -> string is
    let stub_dir: string = fsx::join(fsx::join(fsx::join(b.rb_rootfs, "usr"), "local"), "sbin")
    let e: string = fsx::mkdir_p(stub_dir)
    if e != "" is return e end
    let stub_path: string = fsx::join(stub_dir, "sudo")
    let we: string = fsx::write_file(stub_path, sudo_stub_text(), 493)
    if we != "" is return "zapis sudo-stub: " + we end
    ui::info("  sudo-stub zainstalowany: " + stub_path)
    return ""
end

fn remove_sudo_stub(b: Builder) is
    let stub_path: string = fsx::join(fsx::join(fsx::join(fsx::join(b.rb_rootfs, "usr"), "local"), "sbin"), "sudo")
    if fsx::lexists(stub_path) is
        if proc::run_or_error(["rm", "-f", stub_path]) != "" is
            ui::warn("Nie mozna usunac sudo-stub " + stub_path + ": blad")
        end
    end
end

pub fn boot_has_any_kernel(rootfs: string) -> bool is
    return array_len(fsx::glob_prefix(fsx::join(rootfs, "boot"), "vmlinuz-")) > 0
end

pub fn packages_with_live_boot(b: Builder) -> [string] is
    let mut pkgs: [string] = b.rb_project.lp_packages
    if b.rb_container_mode is return pkgs end
    let lb: [string] = ["live-boot", "live-boot-initramfs-tools"]
    let mut i: int = 0
    while i < array_len(lb) is
        let p: string = lb[i]
        i += 1
        if !strx::contains(pkgs, p) && !strx::contains(b.rb_project.lp_excluded, p) is
            ui::info("  dopisuje " + ui::quote(p) + " do pakietow (wymagane przez boot=live; live-build robi to automatycznie)")
            pkgs = array_push(pkgs, p)
        end
    end
    return pkgs
end

fn install_packages(b: Builder) -> string is
    let e: string = sandbox_exec(b, ["apt-get", "update"])
    if e != "" is return "apt-get update: " + e end
    if array_len(b.rb_project.lp_packages) == 0 is return "" end
    return apt_install_with_progress(b, "pakiety projektu", packages_with_live_boot(b), ["-o", "APT::Get::Assume-Yes=true"])
end

fn write_initramfs_conf(b: Builder) -> string is
    let conf_dir: string = fsx::join(fsx::join(fsx::join(b.rb_rootfs, "etc"), "initramfs-tools"), "conf.d")
    let e: string = fsx::mkdir_p(conf_dir)
    if e != "" is return e end
    let conf: string = "# hackeros-builder: initrd musi dzialac na DOWOLNYM sprzecie (live ISO), nie tylko na hoscie budujacym.\nMODULES=most\n"
    let we: string = fsx::write_file(fsx::join(conf_dir, "hackeros-live.conf"), conf, 420)
    if we != "" is return we end
    let modules: string = "# hackeros-builder: moduly wymagane przez boot=live\nsquashfs\noverlay\nloop\nisofs\nudf\nvfat\nnls_cp437\nnls_utf8\nnls_iso8859-1\nsr_mod\nsd_mod\ncdrom\nusb_storage\nuas\nahci\nnvme\nvirtio_blk\nvirtio_scsi\nvirtio_pci\nata_piix\n"
    let mp: string = fsx::join(fsx::join(fsx::join(b.rb_rootfs, "etc"), "initramfs-tools"), "modules")
    let old: string = proc::read_file_or_empty(mp)
    return fsx::write_file(mp, old + modules, 420)
end

fn verify_initrd_script() -> string is
    return "set -e
found=0
for f in /boot/initrd.img-*; do
  [ -e \"$f\" ] || continue
  found=1
  list=$(lsinitramfs \"$f\")
  echo \"$list\" | grep -Eq '(^|/)scripts/live$' || {{ echo \"BLAD: $f nie zawiera scripts/live (brak live-boot-initramfs-tools?)\" >&2; exit 1; }}
  echo \"$list\" | grep -Eq '(^|/)lib/live/boot/' || {{ echo \"BLAD: $f nie zawiera lib/live/boot (brak live-boot?)\" >&2; exit 1; }}
  echo \"$list\" | grep -Eq 'squashfs(\\.ko[^ ]*)?$' || echo \"OSTRZEZENIE: $f nie ma squashfs.ko (moze byc wbudowany w jadro)\" >&2
  echo \"$list\" | grep -Eq 'overlay(\\.ko[^ ]*)?$' || echo \"OSTRZEZENIE: $f nie ma overlay.ko (moze byc wbudowany w jadro)\" >&2
done
[ \"$found\" = 1 ] || {{ echo \"BLAD: brak /boot/initrd.img-*\" >&2; exit 1; }}
"
end

fn verify_initrd(b: Builder) -> string is
    return sandbox_exec(b, ["sh", "-c", verify_initrd_script()])
end

fn apply_extra_sources(b: Builder) -> string is
    let sources_dir: string = fsx::join(fsx::join(fsx::join(b.rb_rootfs, "etc"), "apt"), "sources.list.d")
    let e: string = fsx::mkdir_p(sources_dir)
    if e != "" is return e end
    let list_path: string = fsx::join(sources_dir, "hackeros-extra.list")
    let body: string = array_join(b.rb_project.lp_extra_sources, "\n") + "\n"
    let we: string = fsx::write_file(list_path, body, 420)
    if we != "" is return "tworzenie " + list_path + ": " + we end
    let mut i: int = 0
    while i < array_len(b.rb_project.lp_extra_keys) is
        let key_path: string = b.rb_project.lp_extra_keys[i]
        i += 1
        let dest: string = fsx::join(fsx::join(fsx::join(fsx::join(b.rb_rootfs, "etc"), "apt"), "trusted.gpg.d"), fsx::basename(key_path))
        let ce: string = fsx::copy_file(key_path, dest, 420)
        if ce != "" is return "kopiowanie klucza GPG " + key_path + ": " + ce end
    end
    return ""
end

fn remove_existing_entry(dest: string) -> string is
    if !fsx::lexists(dest) is return "" end
    if fsx::is_dir(dest) && !fsx::is_symlink(dest) is
        return dest + " jest juz katalogiem w rootfs, a includes.chroot probuje nadpisac go plikiem/symlinkiem -- to prawdopodobnie blad w strukturze projektu (sciezka zajeta przez pakiet lub inny wczesniejszy krok), sprawdz zawartosc includes.chroot* recznie"
    end
    let r: string = proc::run_or_error(["rm", "-f", dest])
    if r != "" is return "usuwanie istniejacego wpisu " + dest + " przed nadpisaniem: " + r end
    return ""
end

;; filepath.Walk(srcDir) -> kopiowanie do rootfs (katalogi: prawa & ~umask, pliki: dokladne prawa, symlinki odtwarzane)
pub fn copy_dir_to_dir(src_dir: string, dest_root: string) -> string is
    let listing: string = shell("cd " + proc::sq(src_dir) + " && find . -mindepth 1 -printf '%P\\037%y\\037%m\\n' | LC_ALL=C sort")
    let lines: [string] = fsx::non_empty_lines(listing)
    let mut i: int = 0
    while i < array_len(lines) is
        let f: [string] = string_split(lines[i], "\x1f")
        i += 1
        let rel: string = f[0]
        let kind: string = f[1]
        let mode: int = fsx::oct(f[2])
        let src: string = fsx::join(src_dir, rel)
        let dest: string = fsx::join(dest_root, rel)
        if kind == "d" is
            let e: string = fsx::mkdir_all_mode(dest, mode)
            if e != "" is return e end
        else is
            let re: string = remove_existing_entry(dest)
            if re != "" is return re end
            if kind == "l" is
                let target: string = fsx::readlink(src)
                let se: string = fsx::symlink_force(target, dest)
                if se != "" is return se end
            else is
                let ce: string = fsx::copy_file(src, dest, mode)
                if ce != "" is return ce end
            end
        end
    end
    return ""
end

fn copy_dir_to_rootfs(b: Builder, src_dir: string) -> string is
    return copy_dir_to_dir(src_dir, b.rb_rootfs)
end

fn ensure_hook_interpreters(b: Builder, hooks: [liveparse::HookScript]) -> string is
    let mut order: [string] = []
    let mut i: int = 0
    while i < array_len(hooks) is
        let pkg: string = hooklang::interpreter_package(hooks[i].hs_interp)
        i += 1
        if pkg != "" && !strx::contains(order, pkg) is order = array_push(order, pkg) end
    end
    if array_len(order) == 0 is return "" end
    order = strx::sort_strings(order)
    ui::info("  interpretery hookow: instalacja " + array_join(order, ", ") + "...")
    let args: [string] = strx::concat(["apt-get", "install", "-y", "-o", "Dpkg::Options::=--force-confdef", "-o", "Dpkg::Options::=--force-confold"], order)
    let e: string = sandbox_exec(b, args)
    if e != "" is return "instalacja interpreterow hookow (" + proc::format_args(order) + "): " + e end
    return ""
end

fn run_hooks_inner(b: Builder) -> string is
    let hooks: [liveparse::HookScript] = b.rb_project.lp_hooks
    if array_len(hooks) == 0 is
        ui::info("  brak hookow (config/hooks/normal|live/*.hook.chroot) -- pominieto")
        return ""
    end
    let pe: string = ensure_hook_interpreters(b, hooks)
    if pe != "" is return "przygotowanie interpreterow hookow: " + pe end
    let mut bar: prog::Bar = prog::new("hooki", array_len(hooks), "hookow")
    let mut i: int = 0
    while i < array_len(hooks) is
        let h: liveparse::HookScript = hooks[i]
        ui::substep("[" + to_string(i + 1) + "/" + to_string(array_len(hooks)) + "] " + h.hs_name + "  " + ui::magenta("(" + hooklang::label(h.hs_interp) + ")"))
        let tmp_name: string = "/tmp-hackeros-hook-" + h.hs_name
        let dest_on_host: string = fsx::join(b.rb_rootfs, tmp_name)
        let ce: string = fsx::copy_file(h.hs_path, dest_on_host, 493)
        if ce != "" is
            bar = prog::fail(bar, h.hs_name)
            return "kopiowanie hooka " + h.hs_name + ": " + ce
        end
        let err: string = sandbox::exec_hook(b.rb_rootfs, tmp_name)
        fsx::remove(dest_on_host)
        if err != "" is
            bar = prog::fail(bar, h.hs_name)
            if string_starts_with(err, "przekroczono limit czasu") is
                return "hook " + h.hs_name + ": " + err + " -- hook prawdopodobnie czeka na interaktywna odpowiedz (np. whiptail/dialog/apt-get bez -y/'read' na cos co nigdy nie nadejdzie); nienadzorowany build ('hackeros-builder build ...') NIE MOZE dostarczyc takiej odpowiedzi -- popraw hook zeby dzialal w pelni bez interakcji (np. dopisz -y do apt-get/dpkg, ustaw DEBIAN_FRONTEND=noninteractive we wlasnych podprocesach hooka), albo podnies limit zmienna HACKEROS_HOOK_TIMEOUT_SECONDS jesli hook LEGALNIE potrzebuje wiecej czasu (kompilacja, duze pobieranie)"
            end
            if h.hs_interp != "" && !hooklang::is_recognized(h.hs_interp) is
                return "wykonanie hooka " + h.hs_name + " (interpreter " + ui::quote(h.hs_interp) + " z shebang) nie powiodlo sie: " + err + " -- " + ui::quote(h.hs_interp) + " NIE jest jednym z jezykow z automatyczna instalacja interpretera (patrz lista nizej); jesli " + ui::quote(h.hs_interp) + " to faktycznie prawidlowy interpreter, dodaj odpowiedni pakiet recznie w config/package-lists/*.list.chroot PRZED tym hookiem (numeracja prefiksow decyduje o kolejnosci). Jezyki z automatyczna instalacja: " + array_join(hooklang::supported_languages(), "; ")
            end
            return "wykonanie hooka " + h.hs_name + ": " + err
        end
        bar = prog::add(bar, 1)
        i += 1
    end
    bar = prog::finish(bar)
    return ""
end

fn run_hooks(b: Builder) -> string is
    let r: string = run_hooks_inner(b)
    remove_sudo_stub(b)
    return r
end

fn inject_hammer(b: Builder) -> string is
    let mut version: string = env_get("HAMMER_VERSION")
    if version == "" is version = download::latest_hammer_version() end
    let dest_path: string = fsx::join(fsx::join(fsx::join(b.rb_rootfs, "usr"), "bin"), "hammer")
    ui::info("  hammer " + version + " (oci-mode) -> " + dest_path)
    return download::download_hammer(version, dest_path)
end

fn generate_hammer_config(b: Builder) -> string is
    let dest_path: string = fsx::join(fsx::join(fsx::join(b.rb_rootfs, "etc"), "hammer"), "oci.hk")
    let e: string = fsx::mkdir_p(fsx::dirname(dest_path))
    if e != "" is return "tworzenie katalogu " + fsx::dirname(dest_path) + ": " + e end
    let mut p: hkgen::HammerConfigParams = hkgen::empty_params()
    p.hc_os_name = "debian"
    p.hc_require_gpg = true
    p.hc_origin = b.rb_origin
    let we: string = hkgen::write_hammer_config(dest_path, p)
    if we != "" is return "zapis " + dest_path + ": " + we end
    ui::info("  wygenerowano: " + dest_path)
    return ""
end

fn install_hammer_deps(b: Builder) -> string is
    let deps: [string] = hammer_deps()
    ui::info("  hammer: instalacja " + to_string(array_len(deps)) + " bibliotek dynamicznych...")
    let e: string = sandbox_exec(b, ["apt-get", "update"])
    if e != "" is return "apt-get update przed instalacja zaleznosci hammer: " + e end
    let args: [string] = strx::concat(["apt-get", "install", "-y", "--no-install-recommends", "-o", "Dpkg::Options::=--force-confdef", "-o", "Dpkg::Options::=--force-confold"], deps)
    let ie: string = sandbox_exec(b, args)
    if ie != "" is return "instalacja bibliotek hammer (" + proc::format_args(deps) + "): " + ie end
    ui::info("  hammer: weryfikacja bibliotek dynamicznych (ldd)...")
    if sandbox_exec(b, ["ldd", "/usr/bin/hammer"]) != "" is
        ui::warn("ldd /usr/bin/hammer zwrocilo blad -- sprawdz logi powyzej pod katem 'not found'. Brakujace biblioteki mozna dodac do hammerDeps w internal/rootfs/hammer_deps.go")
    end
    return ""
end

