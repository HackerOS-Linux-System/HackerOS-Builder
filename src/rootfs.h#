;; --- apt z paskiem postepu opartym na liniach "Setting up " ---
fn count_apt_planned_ops(rootfs: string, sim_args: [string]) -> int is
    let job: proc::Job = sandbox::start_with_lines(rootfs, [], strx::concat(["apt-get"], sim_args))
    proc::job_wait(job)
    let n: int = proc::job_count(job, ["Inst "])
    proc::job_cleanup(job)
    return n
end

fn apt_install_with_progress(b: Builder, label: string, pkgs: [string], extra: [string]) -> string is
    if array_len(pkgs) == 0 is return "" end
    let sim_args: [string] = strx::concat(strx::concat(["install", "-y", "-s"], extra), pkgs)
    let total: int = count_apt_planned_ops(b.rb_rootfs, sim_args)
    let base: [string] = ["install", "-y", "-o", "Dpkg::Options::=--force-confdef", "-o", "Dpkg::Options::=--force-confold"]
    let install_args: [string] = strx::concat(strx::concat(base, extra), pkgs)
    let bar: prog::Bar = prog::new(label, total, "pakietow")
    let job: proc::Job = sandbox::start_with_lines(b.rb_rootfs, [], strx::concat(["apt-get"], install_args))
    let r: track::TrackRes = track::finish_job(job, bar, ["Setting up "], "apt", "apt-get install")
    if r.tk_rc != 0 is
        return "instalacja pakietow " + label + " (" + proc::format_args(pkgs) + "): sandbox: exec \"apt-get\" w " + b.rb_rootfs + " nie powiodl sie: exit status " + to_string(r.tk_rc)
    end
    return ""
end

fn install_cybersecurity_packages(b: Builder) -> string is
