;; RemoveAptTooling: usuwa apt/apt-get itd. (baza dpkg zostaje dla hammer)
pub fn remove_apt_tooling(rootfs: string) -> string is
    let bins: [string] = ["usr/bin/apt", "usr/bin/apt-get", "usr/bin/apt-cache", "usr/bin/apt-config", "usr/bin/apt-cdrom", "usr/bin/apt-mark", "usr/bin/apt-key"]
    let mut removed: int = 0
    let mut i: int = 0
    while i < array_len(bins) is
        let p: string = fsx::join(rootfs, bins[i])
        i += 1
        if fsx::lexists(p) is
            let r: string = proc::run_or_error(["rm", "-f", p])
            if r != "" is return "usuwanie " + bins[i - 1] + ": " + r end
            removed += 1
        end
    end
    let dirs: [string] = ["usr/lib/apt"]
    let mut j: int = 0
    while j < array_len(dirs) is
        let p2: string = fsx::join(rootfs, dirs[j])
        j += 1
        if fsx::exists(p2) is
            let e: string = fsx::remove_all(p2)
            if e != "" is return "usuwanie katalogu " + dirs[j - 1] + ": " + e end
            removed += 1
        end
    end
    ui::info("  usunieto " + to_string(removed) + " element(ow) apt/apt-get -- baza dpkg (/var/lib/dpkg) pozostawiona nietknieta dla hammer")
    return ""
end

;; --- warstwy ---
struct Next is
    nx_builder:    Builder
    nx_checkpoint: string
    nx_err:        string
end

fn next_layer(b: Builder, name: string, checkpoint: string, layers_dir: string) -> Next is
    let after: string = checkpoint + ".next"
    let se: string = layers::snapshot_tree(b.rb_rootfs, after)
    if se != "" is return Next { nx_builder: b, nx_checkpoint: checkpoint, nx_err: "migawka rootfs po etapie " + ui::quote(name) + ": " + se } end
    let d: layers::Diff = layers::diff_snapshots(checkpoint, after, name)
    let layer_path: string = fsx::join(layers_dir, name + ".tar.gz")
    let w: layers::LayerRes = layers::write_incremental_layer(b.rb_rootfs, d, layer_path)
    if w.ly_err != "" is
        layers::diff_free(d)
        fsx::remove(after)
        return Next { nx_builder: b, nx_checkpoint: checkpoint, nx_err: "zapis warstwy OCI " + ui::quote(name) + ": " + w.ly_err }
    end
    let paths_now: [string] = b.rb_layer_paths
    let mut nb: Builder = b
    if w.ly_wrote is
        nb.rb_layer_paths = array_push(paths_now, layer_path)
        ui::debug("warstwa OCI " + ui::quote(name) + ": " + to_string(d.df_changed_n) + " zmienionych, " + to_string(d.df_removed_n) + " usunietych sciezek -> " + layer_path)
    else is
        ui::debug("warstwa OCI " + ui::quote(name) + ": brak zmian -- pominieta")
    end
    layers::diff_free(d)
    fsx::remove(checkpoint)
    return Next { nx_builder: nb, nx_checkpoint: after, nx_err: "" }
end

fn fail_build(b: Builder, msg: string) -> BuildRes is
    return BuildRes { bd_builder: b, bd_err: msg }
end

pub fn build(b0: Builder) -> BuildRes is
    let mut b: Builder = b0
    let mut section_label: string = "Budowa rootfs"
    if b.rb_container_mode is section_label = "Budowa rootfs (kontener roboczy)" end
    ui::section(section_label)
    let pd: string = prepare_dir(b)
    if pd != "" is return fail_build(b, pd) end
    let layers_dir: string = fsx::join(b.rb_work, "layers")
    let le: string = fsx::mkdir_p(layers_dir)
    if le != "" is return fail_build(b, "tworzenie katalogu warstw OCI (" + layers_dir + "): " + le) end
    b.rb_layer_paths = []
    let mut checkpoint: string = proc::tmp_path("snap") + ".0"
    let ce0: string = layers::snapshot_tree(b.rb_rootfs, checkpoint)
    if ce0 != "" is return fail_build(b, "migawka poczatkowa rootfs: " + ce0) end

    ui::step(0, 10, "sprawdzanie/pobieranie narzedzi build-time...")
    let tc: toolchain::Manager = toolchain::new_manager(b.rb_work)
    let te: string = toolchain::prepare_all(tc)
    if te != "" is return fail_build(b, "toolchain: " + te) end
    env_set("PATH", string_slice(toolchain::env(tc)[0], 5, string_len(toolchain::env(tc)[0])))

    ui::step(1, 10, "debootstrap (" + b.rb_cfg.cfg_release + ")...")
    let de: string = run_debootstrap(b)
    if de != "" is return fail_build(b, "debootstrap: " + de) end

    ui::step(2, 10, "preseed debconf + sudo-stub...")
    let sd: string = seed_debconf(b)
    if sd != "" is return fail_build(b, "preseed debconf: " + sd) end
    let ss: string = install_sudo_stub(b)
    if ss != "" is return fail_build(b, "sudo stub: " + ss) end
    if !b.rb_container_mode is
        let wi: string = write_initramfs_conf(b)
        if wi != "" is return fail_build(b, "konfiguracja initramfs-tools: " + wi) end
    end

    if b.rb_project.lp_includes_before != "" is
        ui::step(3, 10, "kopiowanie includes.chroot_before_packages...")
        let ce: string = copy_dir_to_rootfs(b, b.rb_project.lp_includes_before)
        if ce != "" is return fail_build(b, "includes.chroot_before_packages: " + ce) end
    else is
        ui::step(3, 10, "brak includes.chroot_before_packages -- pominieto")
    end

    if array_len(b.rb_project.lp_extra_sources) > 0 is
        ui::step(4, 10, "dodatkowe zrodla apt (" + to_string(array_len(b.rb_project.lp_extra_sources)) + ")...")
        let ae: string = apply_extra_sources(b)
        if ae != "" is return fail_build(b, "extra sources: " + ae) end
    else is
        ui::step(4, 10, "brak dodatkowych zrodel apt -- pominieto")
    end

    ui::step(5, 10, "instalacja systemu MAC ([project] -> selinux=" + (if b.rb_cfg.pj_mac == "selinux" then "true" else "false") + ")...")
    let me: string = install_mac_packages(b)
    if me != "" is return fail_build(b, "instalacja MAC: " + me) end

    if config::is_cybersecurity(b.rb_cfg) is
        ui::step(6, 10, "pakiety cybersecurity ([project] -> type=cybersecurity)...")
        let cy: string = install_cybersecurity_packages(b)
        if cy != "" is return fail_build(b, "instalacja pakietow cybersecurity: " + cy) end
    else is
        ui::step(6, 10, "[project] -> type != cybersecurity -- pominieto")
    end

    let n1: Next = next_layer(b, "base", checkpoint, layers_dir)
    if n1.nx_err != "" is return fail_build(b, "warstwa OCI 'base': " + n1.nx_err) end
    checkpoint = n1.nx_checkpoint
    b = n1.nx_builder

    ui::step(7, 10, "instalacja " + to_string(array_len(b.rb_project.lp_packages)) + " pakiet(ow)...")
    let ip: string = install_packages(b)
    if ip != "" is return fail_build(b, "instalacja pakietow: " + ip) end
    let n2: Next = next_layer(b, "packages", checkpoint, layers_dir)
    if n2.nx_err != "" is return fail_build(b, "warstwa OCI 'packages': " + n2.nx_err) end
    checkpoint = n2.nx_checkpoint
    b = n2.nx_builder

    let has_after: bool = b.rb_project.lp_includes_chroot != "" || b.rb_project.lp_includes_after != ""
    if has_after is
        ui::step(8, 10, "kopiowanie includes.chroot / includes.chroot_after_packages...")
        if b.rb_project.lp_includes_chroot != "" is
            let c1: string = copy_dir_to_rootfs(b, b.rb_project.lp_includes_chroot)
            if c1 != "" is return fail_build(b, "includes.chroot: " + c1) end
        end
        if b.rb_project.lp_includes_after != "" is
            let c2: string = copy_dir_to_rootfs(b, b.rb_project.lp_includes_after)
            if c2 != "" is return fail_build(b, "includes.chroot_after_packages: " + c2) end
        end
    else is
        ui::step(8, 10, "brak includes.chroot/includes.chroot_after_packages -- pominieto")
    end

    ui::step(9, 10, "wykonywanie " + to_string(array_len(b.rb_project.lp_hooks)) + " hook(ow)...")
    let rh: string = run_hooks(b)
    if rh != "" is return fail_build(b, "hooks: " + rh) end

    if boot_has_any_kernel(b.rb_rootfs) is
        ui::info("  koncowe przebudowanie initrd (update-initramfs -u -k all)...")
        let ue: string = sandbox_exec(b, ["update-initramfs", "-u", "-k", "all"])
        if ue != "" is
            return fail_build(b, "update-initramfs -u -k all: " + ue + " -- initrd.img w /boot moze NIE zawierac hookow live-boot/dodatkowych modulow dopisanych PO instalacji kernela (includes.chroot_after_packages, hooki) -- bez poprawnego initrd live-medium konczy sie panika \"Attempted to kill init!\" przy starcie")
        end
        if !b.rb_container_mode is
            ui::info("  weryfikacja initrd (live-boot, squashfs, overlay)...")
            let vi: string = verify_initrd(b)
            if vi != "" is
                return fail_build(b, "weryfikacja initrd: " + vi + " -- initrd bez live-boot = panika jadra \"Attempted to kill init!\" przy starcie live-medium (sprawdz czy pakiety live-boot i live-boot-initramfs-tools sie zainstalowaly i nie sa wykluczone przez \"-live-boot\" w package-lists)")
            end
        end
    else is
        ui::info("  brak jadra w /boot -- pomijam koncowe update-initramfs (typowe dla ContainerMode)")
    end
    let n3: Next = next_layer(b, "hooks", checkpoint, layers_dir)
    if n3.nx_err != "" is return fail_build(b, "warstwa OCI 'hooks': " + n3.nx_err) end
    checkpoint = n3.nx_checkpoint
    b = n3.nx_builder

    if b.rb_container_mode is
        ui::step(10, 10, "tryb kontenera roboczego (ContainerMode) -- pomijam wstrzykiwanie hammer/oci.hk")
    else is
        ui::step(10, 10, "wstrzykiwanie hammer + generowanie /etc/hammer/oci.hk...")
        let ih: string = inject_hammer(b)
        if ih != "" is return fail_build(b, "hammer injection: " + ih) end
        let hd: string = install_hammer_deps(b)
        if hd != "" is return fail_build(b, "hammer biblioteki dynamiczne: " + hd) end
        let gh: string = generate_hammer_config(b)
        if gh != "" is return fail_build(b, "generowanie /etc/hammer/oci.hk: " + gh) end
        let n4: Next = next_layer(b, "runtime", checkpoint, layers_dir)
        if n4.nx_err != "" is return fail_build(b, "warstwa OCI 'runtime': " + n4.nx_err) end
        b = n4.nx_builder
        checkpoint = n4.nx_checkpoint
    end
    fsx::remove(checkpoint)
    ui::info("Rootfs zbudowany: " + b.rb_rootfs)
    return BuildRes { bd_builder: b, bd_err: "" }
end

;; ============================ WALIDACJA ============================

fn stat_err(p: string) -> string is
    return "stat " + p + ": no such file or directory"
end

;; ValidateRootfs: "" = OK
pub fn validate_rootfs(rootfs: string, require_hammer: bool, min_size_opt: int, min_pkgs_opt: int) -> string is
    if !fsx::exists(rootfs) is return "rootfs " + rootfs + " nie istnieje/nie mozna odczytac: " + stat_err(rootfs) end
    if !fsx::is_dir(rootfs) is return "rootfs " + rootfs + " nie jest katalogiem" end
    let min_size: int = if min_size_opt <= 0 then 52428800 else min_size_opt
    let min_pkgs: int = if min_pkgs_opt <= 0 then 10 else min_pkgs_opt
    let total: int = fsx::tree_size(rootfs)
    if total < min_size is
        return "rootfs wyglada na niekompletny: " + ui::format_bytes(total) + " calkowitego rozmiaru, oczekiwano co najmniej " + ui::format_bytes(min_size) + " (debootstrap/instalacja pakietow prawdopodobnie zostaly przerwane w polowie -- brak miejsca na dysku, OOM killer, przerwane polaczenie z mirrorem) -- NIE wypychamy tego do registry"
    end
    let req: [string] = ["etc", "usr/bin", "var/lib/dpkg/status", "var/lib/dpkg"]
    let mut i: int = 0
    while i < array_len(req) is
        let p: string = fsx::join(rootfs, req[i])
        if !fsx::exists(p) is
            return "rootfs wyglada na niekompletny: brak " + req[i] + " (" + stat_err(p) + ") -- to nie wyglada na dzialajacy system Debian -- NIE wypychamy tego do registry"
        end
        i += 1
    end
    if require_hammer is
        let p2: string = fsx::join(fsx::join(fsx::join(rootfs, "etc"), "hammer"), "oci.hk")
        if !fsx::exists(p2) is
            return "rootfs nie zawiera /etc/hammer/oci.hk (" + stat_err(p2) + ") -- wstrzykniecie hammer prawdopodobnie zawiodlo mimo ze Build() zglosil sukces -- NIE wypychamy tego do registry"
        end
    end
    let status_path: string = fsx::join(fsx::join(fsx::join(rootfs, "var"), "lib"), fsx::join("dpkg", "status"))
    let cnt_txt: string = string_trim(shell("grep -c '^Package: ' " + proc::sq(status_path) + " 2>/dev/null"))
    let pkg_count: int = if cnt_txt == "" then 0 else str_to_int(cnt_txt)
    if pkg_count < min_pkgs is
        return "baza dpkg zawiera tylko " + to_string(pkg_count) + " pakiet(ow), oczekiwano co najmniej " + to_string(min_pkgs) + " -- rootfs wyglada na niekompletny (debootstrap prawdopodobnie nie skonczyl instalacji bazowej) -- NIE wypychamy tego do registry"
    end
    ui::info("Walidacja rootfs OK: " + ui::format_bytes(total) + ", " + to_string(pkg_count) + " pakietow dpkg, wszystkie wymagane sciezki obecne")
    return ""
end
