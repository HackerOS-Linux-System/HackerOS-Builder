pub fn val_at(doc: HkDoc, key: string) -> HkVal is
    let i: int = idx(doc, key)
    if i < 0 is return no_val() end
    return HkVal { hv_ok: true, hv_kind: doc.hk_kinds[i], hv_text: doc.hk_vals[i] }
end

pub fn has_section(doc: HkDoc, name: string) -> bool is
    return kind_of(doc, name) == "m"
end

;; sec.Get(key): bezposredni potomek sekcji (bez rozwijania kropek)
pub fn get_child(doc: HkDoc, section: string, key: string) -> HkVal is
    return val_at(doc, section + sep() + key)
end

;; AsString() daje wynik (string/number/bool)?
pub fn string_ok(v: HkVal) -> bool is
    return v.hv_ok && (v.hv_kind == "s" || v.hv_kind == "n" || v.hv_kind == "b")
end

pub fn as_string(v: HkVal) -> string is
    if v.hv_kind == "n" is return format_number(v.hv_text) end
    return v.hv_text
end

pub fn type_mismatch_string(v: HkVal) -> string is
    return "hk: TypeMismatch -- nie mozna skonwertowac " + kind_name(v.hv_kind) + " na string"
end

;; config.Get(path): sciezka z kropkami i indeksami tablic
pub fn get_path(doc: HkDoc, path: string) -> HkVal is
    let segs: [string] = split_path(path)
    if array_len(segs) == 0 is return no_val() end
    let first: HkVal = val_at(doc, segs[0])
    if !first.hv_ok is return no_val() end
    let mut cur: HkVal = first
    let mut cur_key: string = segs[0]
    let mut i: int = 1
    while i < array_len(segs) is
        let pi: [string] = parse_array_index(segs[i])
        i += 1
        if cur.hv_kind != "m" is return no_val() end
        let next_key: string = cur_key + sep() + pi[0]
        let nv: HkVal = val_at(doc, next_key)
        if !nv.hv_ok is return no_val() end
        cur = nv
        cur_key = next_key
        if pi[1] != "" is
            if cur.hv_kind != "a" is return no_val() end
            let items: [string] = array_items(cur)
            let ix: int = str_to_int(pi[1])
            if ix < 0 || ix >= array_len(items) is return no_val() end
            cur = HkVal { hv_ok: true, hv_kind: item_kind(items[ix]), hv_text: item_text(items[ix]) }
        end
    end
    return cur
end

;; dotted path sekcji.klucza do wyswietlania
fn dotted(key: string) -> string is
    return string_replace(key, sep(), ".")
end

;; ============================ INTERPOLACJA ============================

struct RStr is
    rs_text: string
    rs_err:  string
end

fn resolve_ref(doc: HkDoc, ref: string, self_path: string, resolving: [string]) -> RStr is
    if string_starts_with(ref, "env:") is
        return RStr { rs_text: env_get(string_slice(ref, 4, string_len(ref))), rs_err: "" }
    end
    let mut cyc: bool = ref == self_path
    let mut i: int = 0
    while i < array_len(resolving) is
        if resolving[i] == ref is cyc = true end
        i += 1
    end
    if cyc is return RStr { rs_text: "", rs_err: cyclic_ref(ref) } end
    let v: HkVal = get_path(doc, ref)
    if !v.hv_ok is return RStr { rs_text: "", rs_err: invalid_ref(ref) } end
    if v.hv_kind == "s" && string_contains(v.hv_text, "$" + "{{") is
        return resolve_string(doc, v.hv_text, ref, array_push(resolving, ref))
    end
    if !string_ok(v) is return RStr { rs_text: "", rs_err: type_mismatch_string(v) } end
    return RStr { rs_text: as_string(v), rs_err: "" }
end

fn resolve_string(doc: HkDoc, s: string, self_path: string, resolving: [string]) -> RStr is
    let mut out: string = ""
    let mut i: int = 0
    while i < string_len(s) is
        let tail: string = string_slice(s, i, string_len(s))
        let start: int = string_find(tail, "$" + "{{")
        if start < 0 is
            out = out + tail
            i = string_len(s)
        else is
            out = out + string_slice(tail, 0, start)
            let abs_start: int = i + start
            let sub: string = string_slice(s, abs_start, string_len(s))
            let end_rel: int = string_find(sub, "}")
            if end_rel < 0 is
                return RStr { rs_text: "", rs_err: parse_error(0, 0, "Niezamknieta interpolacja w " + go_quote(s) + " (brak '}')", "") }
            end
            let abs_end: int = abs_start + end_rel
            let ref: string = string_slice(s, abs_start + 2, abs_end)
            let r: RStr = resolve_ref(doc, ref, self_path, resolving)
            if r.rs_err != "" is return r end
            out = out + r.rs_text
            i = abs_end + 1
        end
    end
    return RStr { rs_text: out, rs_err: "" }
end

;; ResolveInterpolations: podmienia ${...} w stringach i elementach tablic (in place).
pub fn resolve_interpolations(doc0: HkDoc) -> HkParse is
    let orig: HkDoc = doc_copy(doc0)
    let mut doc: HkDoc = doc0
    let mut i: int = 0
    while i < array_len(doc.hk_paths) is
        let full: string = dotted(doc.hk_paths[i])
        let kind: string = doc.hk_kinds[i]
        if kind == "s" is
            let r: RStr = resolve_string(doc, doc.hk_vals[i], full, [])
            if r.rs_err != "" is return HkParse { hp_doc: orig, hp_err: r.rs_err } end
            doc = put(doc, doc.hk_paths[i], "s", r.rs_text)
        else if kind == "a" is
            let items: [string] = array_items(HkVal { hv_ok: true, hv_kind: "a", hv_text: doc.hk_vals[i] })
            let mut joined: string = ""
            let mut j: int = 0
            while j < array_len(items) is
                let it: string = items[j]
                let mut piece: string = it
                if item_kind(it) == "s" is
                    let r: RStr = resolve_string(doc, item_text(it), full + "[" + to_string(j) + "]", [])
                    if r.rs_err != "" is return HkParse { hp_doc: orig, hp_err: r.rs_err } end
                    piece = "s" + r.rs_text
                end
                if j > 0 is joined = joined + asep() end
                joined = joined + piece
                j += 1
            end
            doc = put(doc, doc.hk_paths[i], "a", joined)
        end
        i += 1
    end
    return HkParse { hp_doc: doc, hp_err: "" }
end

;; ============================ SERIALIZACJA / BUILDER ============================

fn looks_like_number_or_bool(s: string) -> bool is
    let low: string = string_lower(s)
    return low == "true" || low == "false" || is_number(s)
end

fn serialize_string(s: string) -> string is
    let needs: bool = s == "" || string_contains(s, "\n") || string_contains(s, "\t") || string_contains(s, "\r") || string_contains(s, "\"") || string_contains(s, "\\") || looks_like_number_or_bool(s) || string_trim(s) != s
    if !needs is return s end
    let e1: string = string_replace(s, "\\", "\\\\")
    let e2: string = string_replace(e1, "\"", "\\\"")
    let e3: string = string_replace(string_replace(string_replace(e2, "\n", "\\n"), "\t", "\\t"), "\r", "\\r")
    return "\"" + e3 + "\""
end

fn serialize_scalar(kind: string, text: string) -> string is
    if kind == "s" is return serialize_string(text) end
    if kind == "n" is return format_number(text) end
    return text
end

fn write_map_lines(doc: HkDoc, key: string, depth: int) -> string is
    let prefix: string = string_repeat("-", depth) + ">"
    let kids: [string] = children(doc, key)
    let mut out: string = ""
    let mut i: int = 0
    while i < array_len(kids) is
        let k: string = kids[i]
        let kind: string = kind_of(doc, k)
        let name: string = last_segment(k)
        i += 1
        if kind == "m" is
            out = out + prefix + " " + name + "\n" + write_map_lines(doc, k, depth + 1)
        else if kind == "a" is
            let items: [string] = array_items(val_at(doc, k))
            let mut parts: [string] = []
            let mut j: int = 0
            while j < array_len(items) is
                parts = array_push(parts, serialize_scalar(item_kind(items[j]), item_text(items[j])))
                j += 1
            end
            out = out + prefix + " " + name + " => [" + array_join(parts, ", ") + "]\n"
        else is
            out = out + prefix + " " + name + " => " + serialize_scalar(kind, val_at(doc, k).hv_text) + "\n"
        end
    end
    return out
end

pub fn serialize(doc: HkDoc) -> string is
    let mut b: string = ""
    let sections: [string] = children(doc, "")
    let mut i: int = 0
    while i < array_len(sections) is
        if kind_of(doc, sections[i]) == "m" is
            b = b + "[" + sections[i] + "]\n" + write_map_lines(doc, sections[i], 1) + "\n"
        end
        i += 1
    end
    let mut t: string = b
    while string_ends_with(t, "\n") is t = string_slice(t, 0, string_len(t) - 1) end
    return t + "\n"
end

pub fn write_file(path: string, doc: HkDoc) -> string is
    let e: string = fsx::write_file(path, serialize(doc), 420)
    if e != "" is return "hk: nie mozna zapisac " + path + ": " + e end
    return ""
end

;; Builder: Section(name).Set(key, value)
fn ensure_section(doc: HkDoc, name: string) -> HkDoc is
    if kind_of(doc, name) == "" is return put(doc, name, "m", "") end
    return doc
end

pub fn set_string(doc: HkDoc, section: string, key: string, v: string) -> HkDoc is
    return put(ensure_section(doc, section), section + sep() + key, "s", v)
end

pub fn set_bool(doc: HkDoc, section: string, key: string, v: bool) -> HkDoc is
    let t: string = if v then "true" else "false"
    return put(ensure_section(doc, section), section + sep() + key, "b", t)
end
