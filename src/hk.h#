pub struct HkDoc is
    pub hk_paths: [string]
    pub hk_kinds: [string]
    pub hk_vals:  [string]
end

pub struct HkParse is
    pub hp_doc: HkDoc
    pub hp_err: string
end

pub struct HkVal is
    pub hv_ok:   bool
    pub hv_kind: string
    pub hv_text: string
end

struct PState is
    ps_doc:     HkDoc
    ps_err:     string
    ps_section: string
    ps_stack:   [string]
end

fn sep() -> string is return "\x1e" end
fn asep() -> string is return "\x1f" end

pub fn doc_copy(d: HkDoc) -> HkDoc is
    return HkDoc { hk_paths: d.hk_paths, hk_kinds: d.hk_kinds, hk_vals: d.hk_vals }
end

pub fn doc_new() -> HkDoc is
    return HkDoc { hk_paths: [], hk_kinds: [], hk_vals: [] }
end

pub fn no_val() -> HkVal is
    return HkVal { hv_ok: false, hv_kind: "", hv_text: "" }
end

;; --- bledy (komunikaty identyczne jak w Go) ---
pub fn parse_error(line: int, col: int, msg: string, hint: string) -> string is
    let base: string = "parse error\n  -> at " + to_string(line) + ":" + to_string(col) + "\n\n  " + msg
    if hint != "" is return base + "\n\nHint: " + hint end
    return base
end
pub fn key_conflict(key: string) -> string is return "hk: KeyConflict(" + key + ")" end
pub fn invalid_ref(path: string) -> string is return "hk: InvalidReference(" + path + ") -- sprawdz czy sciezka istnieje" end
pub fn cyclic_ref(path: string) -> string is return "hk: CyclicReference(" + path + ")" end
pub fn kind_name(k: string) -> string is
    if k == "s" is return "string" end
    if k == "n" is return "number" end
    if k == "b" is return "bool" end
    if k == "a" is return "array" end
    if k == "m" is return "map" end
    return "unknown"
end

;; --- operacje na plaskim drzewie ---
pub fn idx(doc: HkDoc, key: string) -> int is
    let mut i: int = 0
    while i < array_len(doc.hk_paths) is
        if doc.hk_paths[i] == key is return i end
        i += 1
    end
    return -1
end

fn put(doc: HkDoc, key: string, kind: string, val: string) -> HkDoc is
    let i: int = idx(doc, key)
    if i >= 0 is
        let mut ks: [string] = doc.hk_kinds
        let mut vs: [string] = doc.hk_vals
        ks = array_set(ks, i, kind)
        vs = array_set(vs, i, val)
        return HkDoc { hk_paths: doc.hk_paths, hk_kinds: ks, hk_vals: vs }
    end
    return HkDoc { hk_paths: array_push(doc.hk_paths, key), hk_kinds: array_push(doc.hk_kinds, kind), hk_vals: array_push(doc.hk_vals, val) }
end

;; usuwa wszystkich potomkow wezla (nie sam wezel)
fn drop_children(doc: HkDoc, key: string) -> HkDoc is
    let pre: string = key + sep()
    let mut p: [string] = []
    let mut k: [string] = []
    let mut v: [string] = []
    let mut i: int = 0
    while i < array_len(doc.hk_paths) is
        if !string_starts_with(doc.hk_paths[i], pre) is
            p = array_push(p, doc.hk_paths[i])
            k = array_push(k, doc.hk_kinds[i])
            v = array_push(v, doc.hk_vals[i])
        end
        i += 1
    end
    return HkDoc { hk_paths: p, hk_kinds: k, hk_vals: v }
end

pub fn kind_of(doc: HkDoc, key: string) -> string is
    let i: int = idx(doc, key)
    if i < 0 is return "" end
    return doc.hk_kinds[i]
end

;; bezposredni potomkowie (pelne klucze), w kolejnosci wstawiania
pub fn children(doc: HkDoc, key: string) -> [string] is
    let pre: string = if key == "" then "" else key + sep()
    let mut out: [string] = []
    let mut i: int = 0
    while i < array_len(doc.hk_paths) is
        let p: string = doc.hk_paths[i]
        if string_starts_with(p, pre) && string_len(p) > string_len(pre) is
            let rest: string = string_slice(p, string_len(pre), string_len(p))
            if !string_contains(rest, sep()) is out = array_push(out, p) end
        end
        i += 1
    end
    return out
end

pub fn last_segment(key: string) -> string is
    let parts: [string] = string_split(key, sep())
    return parts[array_len(parts) - 1]
end

;; --- splitPath / parseArrayIndex ---
pub fn split_path(path: string) -> [string] is
    let mut segs: [string] = []
    let mut cur: string = ""
    let mut in_q: bool = false
    let mut i: int = 0
    while i < string_len(path) is
        let c: string = string_at(path, i)
        i += 1
        if c == "\"" is
            in_q = !in_q
        else if c == "." && !in_q is
            segs = array_push(segs, cur)
            cur = ""
        else is
            cur = cur + c
        end
    end
    if string_len(cur) > 0 || array_len(segs) > 0 is segs = array_push(segs, cur) end
    return segs
end

;; zwraca [base, idx|"" ] - "" gdy brak indeksu
pub fn parse_array_index(seg: string) -> [string] is
    let o: int = string_find(seg, "[")
    let c: int = string_find(seg, "]")
    if o < 0 || c < 0 || c < o is return [seg, ""] end
    let base: string = string_slice(seg, 0, o)
    let num: string = string_slice(seg, o + 1, c)
    let mut started: bool = false
    let mut neg: bool = false
    let mut digits: string = ""
    let mut i: int = 0
    while i < string_len(num) is
        let ch: string = string_at(num, i)
        i += 1
        if ch == "-" && !started is
            neg = true
            started = true
        else if ch < "0" || ch > "9" is
            return [seg, ""]
        else is
            digits = digits + ch
            started = true
        end
    end
    let n: int = if digits == "" then 0 else str_to_int(digits)
    if neg is return [base, to_string(0 - n)] end
    return [base, to_string(n)]
end

;; --- liczby ---
fn is_digit(c: string) -> bool is return c >= "0" && c <= "9" end

;; strconv.ParseFloat zaakceptowalby ten literal (bez heksadecymalnych)?
pub fn is_number(raw: string) -> bool is
    let mut s: string = raw
    if string_len(s) == 0 is return false end
    if string_starts_with(s, "+") || string_starts_with(s, "-") is s = string_slice(s, 1, string_len(s)) end
    let low: string = string_lower(s)
    if low == "inf" || low == "infinity" || low == "nan" is return true end
    let n: int = string_len(s)
    let mut i: int = 0
    let mut nd: int = 0
    while i < n && is_digit(string_at(s, i)) is
        i += 1
        nd += 1
    end
    if i < n && string_at(s, i) == "." is
        i += 1
        while i < n && is_digit(string_at(s, i)) is
            i += 1
            nd += 1
        end
    end
    if nd == 0 is return false end
    if i < n && (string_at(s, i) == "e" || string_at(s, i) == "E") is
        i += 1
        if i < n && (string_at(s, i) == "+" || string_at(s, i) == "-") is i += 1 end
        let mut ed: int = 0
        while i < n && is_digit(string_at(s, i)) is
            i += 1
            ed += 1
        end
        if ed == 0 is return false end
    end
    return i == n
end

fn strip_lead_zeros(d: string) -> string is
    let mut i: int = 0
    while i < string_len(d) - 1 && string_at(d, i) == "0" is i += 1 end
    return string_slice(d, i, string_len(d))
end

;; formatNumber z Go: calkowite -> %d, reszta -> %g (najkrotsza reprezentacja)
pub fn format_number(raw: string) -> string is
    let mut s: string = raw
    let mut neg: bool = false
    if string_starts_with(s, "+") is s = string_slice(s, 1, string_len(s)) end
    if string_starts_with(s, "-") is
        neg = true
        s = string_slice(s, 1, string_len(s))
    end
    let low: string = string_lower(s)
    if low == "inf" || low == "infinity" is
        if neg is return "-Inf" end
        return "+Inf"
    end
    if low == "nan" is return "NaN" end
    let mut mant: string = s
    let mut exp: int = 0
    let epos: int = if string_find(low, "e") >= 0 then string_find(low, "e") else -1
    if epos >= 0 is
        mant = string_slice(s, 0, epos)
        let et: string = string_slice(s, epos + 1, string_len(s))
        if string_starts_with(et, "+") is exp = str_to_int(string_slice(et, 1, string_len(et)))
        else if string_starts_with(et, "-") is exp = 0 - str_to_int(string_slice(et, 1, string_len(et)))
        else is exp = str_to_int(et) end
    end
    let dot: int = string_find(mant, ".")
    let mut ip: string = mant
    let mut fp: string = ""
    if dot >= 0 is
        ip = string_slice(mant, 0, dot)
        fp = string_slice(mant, dot + 1, string_len(mant))
    end
    let mut digits: string = strip_lead_zeros(ip + fp)
    let mut e10: int = exp - string_len(fp)
    while string_len(digits) > 1 && string_ends_with(digits, "0") is
        digits = string_slice(digits, 0, string_len(digits) - 1)
        e10 += 1
    end
    if digits == "0" is return "0" end
    let sign: string = if neg then "-" else ""
    if e10 >= 0 && string_len(digits) + e10 <= 18 is
        return sign + digits + string_repeat("0", e10)
    end
    let x: int = string_len(digits) + e10 - 1
    if x < -4 || x >= 6 is
        let mut m: string = string_slice(digits, 0, 1)
        if string_len(digits) > 1 is m = m + "." + string_slice(digits, 1, string_len(digits)) end
        let ax: int = if x < 0 then 0 - x else x
        let es: string = if ax < 10 then "0" + to_string(ax) else to_string(ax)
        return sign + m + "e" + (if x < 0 then "-" else "+") + es
    end
    if e10 >= 0 is return sign + digits + string_repeat("0", e10) end
    let nd: int = string_len(digits)
    if nd + e10 > 0 is
        return sign + string_slice(digits, 0, nd + e10) + "." + string_slice(digits, nd + e10, nd)
    end
    return sign + "0." + string_repeat("0", 0 - (nd + e10)) + digits
end

;; --- skalary / tablice ---
pub fn unescape_string(s: string) -> string is
    let mut out: string = ""
    let mut i: int = 0
    while i < string_len(s) is
        let c: string = string_at(s, i)
        if c == "\\" && i + 1 < string_len(s) is
            let n: string = string_at(s, i + 1)
            if n == "n" is out = out + "\n"
            else if n == "t" is out = out + "\t"
            else if n == "r" is out = out + "\r"
            else if n == "\"" is out = out + "\""
            else if n == "\\" is out = out + "\\"
            else is out = out + "\\" + n end
            i += 2
        else is
            out = out + c
            i += 1
        end
    end
    return out
end

pub fn parse_scalar(raw0: string) -> HkVal is
    let raw: string = string_trim(raw0)
    if string_len(raw) >= 2 && string_starts_with(raw, "\"") && string_ends_with(raw, "\"") is
        return HkVal { hv_ok: true, hv_kind: "s", hv_text: unescape_string(string_slice(raw, 1, string_len(raw) - 1)) }
    end
    let low: string = string_lower(raw)
    if low == "true" is return HkVal { hv_ok: true, hv_kind: "b", hv_text: "true" } end
    if low == "false" is return HkVal { hv_ok: true, hv_kind: "b", hv_text: "false" } end
    if is_number(raw) is return HkVal { hv_ok: true, hv_kind: "n", hv_text: raw } end
    return HkVal { hv_ok: true, hv_kind: "s", hv_text: raw }
end

fn split_array_elements(s: string) -> [string] is
    let mut parts: [string] = []
    let mut cur: string = ""
    let mut in_q: bool = false
    let mut esc: bool = false
    let mut i: int = 0
    while i < string_len(s) is
        let c: string = string_at(s, i)
        i += 1
        if esc is
            cur = cur + c
            esc = false
        else if c == "\\" && in_q is
            cur = cur + c
            esc = true
        else if c == "\"" is
            in_q = !in_q
            cur = cur + c
        else if c == "," && !in_q is
            parts = array_push(parts, cur)
            cur = ""
        else is
            cur = cur + c
        end
    end
    if string_len(cur) > 0 is parts = array_push(parts, cur) end
    return parts
end

;; wartosc po "=>": tablica albo skalar. Zwraca HkVal (dla tablicy hv_text = elementy sklejone 0x1f).
pub fn parse_scalar_or_array(raw0: string) -> HkVal is
    let raw: string = string_trim(raw0)
    if string_starts_with(raw, "[") && string_ends_with(raw, "]") && string_len(raw) >= 2 is
        let inner: string = string_trim(string_slice(raw, 1, string_len(raw) - 1))
        if inner == "" is return HkVal { hv_ok: true, hv_kind: "a", hv_text: "" } end
        let parts: [string] = split_array_elements(inner)
        let mut joined: string = ""
        let mut i: int = 0
        while i < array_len(parts) is
            let v: HkVal = parse_scalar(parts[i])
            if i > 0 is joined = joined + asep() end
            joined = joined + v.hv_kind + v.hv_text
            i += 1
        end
        return HkVal { hv_ok: true, hv_kind: "a", hv_text: joined }
    end
    return parse_scalar(raw)
end

pub fn array_items(v: HkVal) -> [string] is
    if v.hv_text == "" is return [] end
    return string_split(v.hv_text, asep())
end
pub fn item_kind(it: string) -> string is return string_slice(it, 0, 1) end
pub fn item_text(it: string) -> string is return string_slice(it, 1, string_len(it)) end

;; ============================ PARSER ============================

fn strip_quotes(s: string) -> string is
    if string_len(s) >= 2 && string_starts_with(s, "\"") && string_ends_with(s, "\"") is
        return string_slice(s, 1, string_len(s) - 1)
    end
    return s
end

fn go_quote(s: string) -> string is
    return "\"" + string_replace(string_replace(s, "\\", "\\\\"), "\"", "\\\"") + "\""
end

fn fail_st(st: PState, msg: string) -> PState is
    return PState { ps_doc: st.ps_doc, ps_err: msg, ps_section: st.ps_section, ps_stack: st.ps_stack }
end

fn with_doc(st: PState, doc: HkDoc) -> PState is
    return PState { ps_doc: doc, ps_err: st.ps_err, ps_section: st.ps_section, ps_stack: st.ps_stack }
end

fn set_node(doc: HkDoc, full: string, kind: string, val: string) -> HkDoc is
    if kind == "m" is
        return put(drop_children(doc, full), full, "m", "")
    end
    return put(doc, full, kind, val)
end

;; Sciezka (klucz) ostatniego segmentu po rozwinieciu kropek.
fn final_key(target: string, key: string) -> string is
    let segs: [string] = split_path(key)
    if array_len(segs) <= 1 is return target + sep() + key end
    let mut cur: string = target
    let mut i: int = 0
    while i < array_len(segs) is
        cur = cur + sep() + segs[i]
        i += 1
    end
    return cur
end

fn insert_dot(st: PState, target: string, key: string, kind: string, val: string) -> PState is
    let segs: [string] = split_path(key)
    let mut doc: HkDoc = st.ps_doc
    if array_len(segs) <= 1 is
        let full: string = target + sep() + key
        if kind_of(doc, full) == "m" && kind != "m" is return fail_st(st, key_conflict(key)) end
        return with_doc(st, set_node(doc, full, kind, val))
    end
    let mut cur: string = target
    let mut i: int = 0
    while i < array_len(segs) - 1 is
        let full: string = cur + sep() + segs[i]
        let ek: string = kind_of(doc, full)
        if ek == "" is
            doc = put(doc, full, "m", "")
        else if ek != "m" is
            let mut pref: [string] = []
            let mut j: int = 0
            while j <= i is
                pref = array_push(pref, segs[j])
                j += 1
            end
            return fail_st(st, key_conflict(array_join(pref, ".")))
        end
        cur = full
        i += 1
    end
    let last: string = cur + sep() + segs[array_len(segs) - 1]
    if kind_of(doc, last) == "m" && kind != "m" is return fail_st(st, key_conflict(key)) end
    return with_doc(st, set_node(doc, last, kind, val))
end

fn handle_section(st: PState, line: string, line_no: int, raw: string) -> PState is
    if !string_ends_with(line, "]") is
        return fail_st(st, parse_error(line_no, string_len(line), "Naglowek sekcji nie jest zamkniety ']'", "Czy zapisano: [nazwa_sekcji]"))
    end
    let name: string = string_trim(string_slice(line, 1, string_len(line) - 1))
    if name == "" is
        return fail_st(st, parse_error(line_no, 2, "Nazwa sekcji nie moze byc pusta", "Przyklad: [metadata]"))
    end
    let ek: string = kind_of(st.ps_doc, name)
    let mut doc: HkDoc = st.ps_doc
    if ek == "" is
        doc = put(doc, name, "m", "")
    else if ek != "m" is
        return fail_st(st, key_conflict(name))
    end
    return PState { ps_doc: doc, ps_err: "", ps_section: name, ps_stack: [name] }
end

fn handle_key_line(st: PState, line: string, line_no: int, raw: string) -> PState is
    if st.ps_section == "" is
        return fail_st(st, parse_error(line_no, 1, "Klucz zdefiniowany przed jakakolwiek sekcja", "Kazdy klucz musi byc wewnatrz [sekcji]"))
    end
    ;; countDashDepth
    let mut depth: int = 0
    while depth < string_len(line) && string_at(line, depth) == "-" is depth += 1 end
    if depth == 0 || depth >= string_len(line) || string_at(line, depth) != ">" is
        return fail_st(st, parse_error(line_no, depth + 1, "Oczekiwano '>' po myslnikach", "Przyklad: -> klucz => wartosc"))
    end
    let rest: string = string_trim(string_slice(line, depth + 1, string_len(line)))
    if rest == "" is
        return fail_st(st, parse_error(line_no, depth + 1, "Brak klucza po myslnikach", "Przyklad: -> klucz => wartosc"))
    end
    if depth > array_len(st.ps_stack) is
        return fail_st(st, parse_error(line_no, 1, "Zbyt gleboki poziom zagniezdzenia (" + to_string(depth) + ") -- brak rodzica", "Kazdy poziom (myslnik) musi miec rodzica zdefiniowanego linia wyzej"))
    end
    let stack: [string] = array_slice(st.ps_stack, 0, depth)
    let target: string = stack[depth - 1]
    let st2: PState = PState { ps_doc: st.ps_doc, ps_err: "", ps_section: st.ps_section, ps_stack: stack }
    let arrow: int = string_find(rest, "=>")
    if arrow < 0 is
        let key_name: string = strip_quotes(string_trim(rest))
        let r: PState = insert_dot(st2, target, key_name, "m", "")
        if r.ps_err != "" is return r end
        return PState { ps_doc: r.ps_doc, ps_err: "", ps_section: r.ps_section, ps_stack: array_push(stack, final_key(target, key_name)) }
    end
    let key_part0: string = string_trim(string_slice(rest, 0, arrow))
    let val_part: string = string_trim(string_slice(rest, arrow + 2, string_len(rest)))
    if key_part0 == "" is
        return fail_st(st2, parse_error(line_no, depth + 1, "Brak nazwy klucza przed '=>'", "Przyklad: -> klucz => wartosc"))
    end
    let v: HkVal = parse_scalar_or_array(val_part)
    let key_part: string = strip_quotes(key_part0)
    return insert_dot(st2, target, key_part, v.hv_kind, v.hv_text)
end

pub fn parse_string(input: string) -> HkParse is
    let lines: [string] = string_split(input, "\n")
    let mut st: PState = PState { ps_doc: doc_new(), ps_err: "", ps_section: "", ps_stack: [] }
    let mut n: int = 0
    while n < array_len(lines) is
        let raw: string = lines[n]
        let line: string = string_trim(raw)
        n += 1
        if line == "" || string_starts_with(line, "!") is
            ;; pusta linia lub komentarz
        else if string_starts_with(line, "[") is
            st = handle_section(st, line, n, raw)
            if st.ps_err != "" is return HkParse { hp_doc: doc_new(), hp_err: st.ps_err } end
        else if string_starts_with(line, "-") is
            st = handle_key_line(st, line, n, raw)
            if st.ps_err != "" is return HkParse { hp_doc: doc_new(), hp_err: st.ps_err } end
        else is
            return HkParse { hp_doc: doc_new(), hp_err: parse_error(n, 1, "Nieoczekiwana linia: " + go_quote(line), "Linie musza zaczynac sie od '!', '[' lub '-'") }
        end
    end
    return HkParse { hp_doc: st.ps_doc, hp_err: "" }
end

pub fn load_file(path: string) -> HkParse is
    if !file_exists(path) is
        return HkParse { hp_doc: doc_new(), hp_err: "hk: nie mozna otworzyc " + path + ": open " + path + ": no such file or directory" }
    end
    return parse_string(fs_read(path))
end

