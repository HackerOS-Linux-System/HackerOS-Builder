#[test]
fn test_verify_installer_accepts_either_bin_dir() is
    let root: string = testutil::tmpdir()
    let all: [string] = ["usr/bin/calamares", "usr/bin/openbox", "usr/bin/xinit", "usr/bin/Xorg", "usr/lib/xorg/modules/input/libinput_drv.so", "etc/calamares/settings.conf", "etc/calamares/modules/finished.conf", "usr/local/sbin/hackeros-bootfix", "etc/calamares/branding/hackeros/branding.desc", "etc/calamares/branding/hackeros/logo.png", "etc/calamares/branding/hackeros/welcome.png", "etc/calamares/branding/hackeros/show.qml", "usr/bin/grub-install", "usr/bin/grub-mkconfig", "usr/bin/efibootmgr", "usr/lib/grub/x86_64-efi/modinfo.sh", "usr/lib/grub/i386-pc/modinfo.sh"]
    let mut i: int = 0
    while i < array_len(all) is
        testutil::put(root + "/" + all[i], "x")
        i += 1
    end
    testutil::eq_s(isobuild::verify_installer(root, "amd64"), "")
end

#[test]
fn test_calamares_config_generates_branding_assets() is
    let root: string = testutil::tmpdir()
    testutil::eq_s(isobuild::write_calamares_config(root, "default", ""), "")
    expect_files(root, ["etc/calamares/settings.conf", "etc/calamares/modules/mount.conf", "etc/calamares/branding/hackeros/logo.png", "etc/calamares/branding/hackeros/welcome.png", "etc/calamares/branding/hackeros/show.qml", "usr/local/sbin/hackeros-bootfix", "usr/local/sbin/hackeros-remove-live-user"])
    let magic: string = string_trim(shell("od -An -tx1 -N8 '" + root + "/etc/calamares/branding/hackeros/logo.png' | tr -d ' \\n'"))
    testutil::eq_s(magic, "89504e470d0a1a0a")
end

#[test]
fn test_calamares_config_uses_project_branding() is
    let root: string = testutil::tmpdir()
    let proj: string = testutil::tmpdir()
    shell("mkdir -p '" + proj + "/config/installer-branding'")
    shell("base64 -d > '" + proj + "/config/installer-branding/debian-logo.png' <<'EOF'\n" + installer_assets::branding_logo_b64_cybersecurity() + "\nEOF")
    testutil::eq_s(isobuild::write_calamares_config(root, "default", proj), "")
    let a: string = string_trim(shell("sha256sum < '" + proj + "/config/installer-branding/debian-logo.png'"))
    let b: string = string_trim(shell("sha256sum < '" + root + "/etc/calamares/branding/hackeros/logo.png'"))
    testutil::eq_s(a, b)
end

