#[test]
fn test_grub_config_has_debug_entry() is
    let iso: string = testutil::tmpdir()
    testutil::eq_s(isobuild::write_grub_config(iso, "HackerOS", true), "")
    let g: string = fs_read(iso + "/boot/grub/grub.cfg")
    testutil::contains(g, "menuentry \"HackerOS\"")
    testutil::contains(g, "(safe graphics)")
    testutil::contains(g, "(debug - bez quiet/splash)")
    testutil::contains(g, "systemd.unit=multi-user.target")
    testutil::contains(g, "earlyprintk=vga")
end

#[test]
fn test_grub_config_without_installer_has_splash() is
    let iso: string = testutil::tmpdir()
    isobuild::write_grub_config(iso, "X", false)
    let g: string = fs_read(iso + "/boot/grub/grub.cfg")
    testutil::contains(g, "quiet splash")
    testutil::is_true(!string_contains(g, "systemd.unit"), "bez instalatora brak systemd.unit")
end

#[test]
fn test_xorriso_wrapper_content_and_executable() is
    let d: string = testutil::tmpdir()
    shell("printf '#!/bin/sh\\nexit 0\\n' > '" + d + "/xorriso' && chmod 755 '" + d + "/xorriso'")
    env_set("PATH", d + ":" + env_get("PATH"))
    let w: string = isobuild::write_xorriso_wrapper(d)
    testutil::is_true(!string_starts_with(w, "!"), "wrapper utworzony")
    testutil::contains(fs_read(w), "-compliance iso_9660_level=3")
    testutil::eq_s(fsx::stat_mode_octal(w), "755")
end

#[test]
fn test_shell_quote() is
    testutil::eq_s(proc::sq("it's"), "'it'\\''s'")
    testutil::eq_s(proc::sq("plain"), "'plain'")
end

#[test]
fn test_kernel_version_pairing() is
    let boot: string = testutil::tmpdir()
    testutil::put(boot + "/vmlinuz-6.1.0-9", "k")
    testutil::put(boot + "/initrd.img-6.1.0-9", "i")
    testutil::put(boot + "/vmlinuz-6.2.0", "k")
    testutil::put(boot + "/initrd.img-6.0.0", "i")
    testutil::eq_s(array_join(isobuild::kernel_versions_with_initrd(boot), ","), "6.1.0-9")
end

