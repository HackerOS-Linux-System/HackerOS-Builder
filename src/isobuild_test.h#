#[test]
fn test_calamares_settings_has_shellprocess_and_no_dm_by_default() is
    let root: string = testutil::tmpdir()
    isobuild::write_calamares_config(root, "default", "")
    let st: string = fs_read(root + "/etc/calamares/settings.conf")
    testutil::contains(st, "shellprocess@done")
    testutil::is_true(!string_contains(st, "- displaymanager"), "bez DM brak modulu displaymanager")
    testutil::contains(fs_read(root + "/etc/calamares/modules/finished.conf"), "restartNowChecked: true")
end

