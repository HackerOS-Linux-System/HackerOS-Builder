mod testutil
mod fsx
mod proc

fn expect_files(root: string, files: [string]) is
    let mut i: int = 0
    while i < array_len(files) is
        testutil::is_true(fsx::exists(root + "/" + files[i]), "brak " + files[i])
        i += 1
    end
end

#[test]
fn test_write_immutability() is
    let root: string = testutil::tmpdir()
    testutil::eq_s(isobuild::write_immutability(root), "")
    expect_files(root, ["usr/sbin/hackeros-immutable", "etc/systemd/system/hackeros-immutable.service"])
    testutil::eq_s(fsx::readlink(root + "/etc/systemd/system/sysinit.target.wants/hackeros-immutable.service"), "/etc/systemd/system/hackeros-immutable.service")
    testutil::is_true(!fsx::exists(root + "/hammer/db/.immutable-enabled"), "bez hammera brak flag")
end

#[test]
fn test_write_immutability_hammer_flags() is
    let root: string = testutil::tmpdir()
    testutil::put(root + "/usr/bin/hammer", "x")
    testutil::eq_s(isobuild::write_immutability(root), "")
    testutil::eq_s(fs_read(root + "/hammer/db/.immutable-enabled"), "1\n")
    testutil::eq_s(fs_read(root + "/hammer/db/.immutable-backend"), "remount\n")
end

#[test]
fn test_installer_autostart_service_based() is
    let root: string = testutil::tmpdir()
    testutil::put(root + "/root/.bash_profile", "x")
    shell("mkdir -p '" + root + "/etc/systemd/system' && ln -s /lib/systemd/system/multi-user.target '" + root + "/etc/systemd/system/default.target'")
    testutil::eq_s(isobuild::write_installer_autostart(root), "")
    let unit: string = fs_read(root + "/etc/systemd/system/hackeros-installer.service")
    testutil::contains(unit, "ConditionKernelCommandLine=boot=live")
    testutil::contains(unit, "Conflicts=getty@tty1.service")
    testutil::contains(unit, "hackeros-installer-session")
    testutil::is_true(fsx::is_symlink(root + "/etc/systemd/system/multi-user.target.wants/hackeros-installer.service"), "usluga enabled")
    testutil::eq_s(fsx::stat_mode_octal(root + "/usr/local/sbin/hackeros-installer-session"), "755")
    testutil::is_true(!fsx::lexists(root + "/root/.bash_profile"), ".bash_profile usuniety")
    testutil::is_true(!fsx::lexists(root + "/etc/systemd/system/default.target"), "default.target override usuniety")
end

