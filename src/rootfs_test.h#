fn make_valid_tree(size_mb: int, pkgs: int) -> string is
    let root: string = testutil::tmpdir()
    shell("mkdir -p '" + root + "/etc' '" + root + "/usr/bin' '" + root + "/var/lib/dpkg'")
    let mut status: string = ""
    let mut i: int = 0
    while i < pkgs is
        status = status + "Package: p" + to_string(i) + "\nStatus: ok\n\n"
        i += 1
    end
    testutil::put(root + "/var/lib/dpkg/status", status)
    if size_mb > 0 is
        shell("dd if=/dev/zero of='" + root + "/usr/bin/big' bs=1M count=" + to_string(size_mb) + " 2>/dev/null")
    end
    return root
end

#[test]
fn test_validate_accepts_minimal_valid_tree() is
    let root: string = make_valid_tree(60, 12)
    testutil::eq_s(rootfs::validate_rootfs(root, false, 0, 0), "")
end

#[test]
fn test_validate_rejects_missing_required_paths() is
    let root: string = make_valid_tree(60, 12)
    shell("rm -rf '" + root + "/etc'")
    testutil::contains(rootfs::validate_rootfs(root, false, 0, 0), "brak etc")
end

#[test]
fn test_validate_rejects_too_few_packages() is
    let root: string = make_valid_tree(60, 3)
    testutil::contains(rootfs::validate_rootfs(root, false, 0, 0), "tylko 3 pakiet")
end

#[test]
fn test_validate_rejects_too_small() is
    let root: string = make_valid_tree(1, 12)
    testutil::contains(rootfs::validate_rootfs(root, false, 0, 0), "niekompletny")
end

#[test]
fn test_validate_require_hammer_config() is
    let root: string = make_valid_tree(60, 12)
    testutil::contains(rootfs::validate_rootfs(root, true, 0, 0), "oci.hk")
    testutil::put(root + "/etc/hammer/oci.hk", "[sysroot]\n")
    testutil::eq_s(rootfs::validate_rootfs(root, true, 0, 0), "")
end

