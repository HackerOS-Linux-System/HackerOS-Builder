#[test]
fn test_copy_dir_overwrites_existing_symlink() is
    let src: string = testutil::tmpdir()
    let dst: string = testutil::tmpdir()
    testutil::put(src + "/etc/motd", "nowy")
    shell("mkdir -p '" + dst + "/etc' && ln -s /etc/passwd '" + dst + "/etc/motd'")
    testutil::eq_s(rootfs::copy_dir_to_dir(src, dst), "")
    testutil::is_true(!fsx::is_symlink(dst + "/etc/motd"), "symlink zastapiony plikiem")
    testutil::eq_s(fs_read(dst + "/etc/motd"), "nowy")
end

