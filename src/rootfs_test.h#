#[test]
fn test_copy_dir_preserves_modes_and_links() is
    let src: string = testutil::tmpdir()
    let dst: string = testutil::tmpdir()
    testutil::put(src + "/bin/run", "x")
    shell("chmod 4755 '" + src + "/bin/run' && ln -s run '" + src + "/bin/lnk' && mkdir -p '" + src + "/priv' && chmod 700 '" + src + "/priv'")
    testutil::eq_s(rootfs::copy_dir_to_dir(src, dst), "")
    testutil::eq_s(fsx::stat_mode_octal(dst + "/bin/run"), "4755")
    testutil::eq_s(fsx::readlink(dst + "/bin/lnk"), "run")
    testutil::eq_s(fsx::stat_mode_octal(dst + "/priv"), "700")
end

fn proj(pkgs: [string], excluded: [string]) -> liveparse::Project is
    let mut p: liveparse::Project = liveparse::empty_project()
    p.lp_packages = pkgs
    p.lp_excluded = excluded
    return p
end

#[test]
fn test_packages_with_live_boot_appends_both() is
    let b: rootfs::Builder = rootfs::new_builder(proj(["vim"], []), config::empty_config(), "/x", "/y")
    let pk: [string] = rootfs::packages_with_live_boot(b)
    testutil::eq_s(array_join(pk, ","), "vim,live-boot,live-boot-initramfs-tools")
end

#[test]
fn test_packages_with_live_boot_respects_exclusion() is
    let b: rootfs::Builder = rootfs::new_builder(proj(["vim"], ["live-boot"]), config::empty_config(), "/x", "/y")
    testutil::eq_s(array_join(rootfs::packages_with_live_boot(b), ","), "vim,live-boot-initramfs-tools")
end

#[test]
fn test_packages_with_live_boot_skipped_in_container_mode() is
    let mut b: rootfs::Builder = rootfs::new_builder(proj(["vim"], []), config::empty_config(), "/x", "/y")
    b.rb_container_mode = true
    testutil::eq_s(array_join(rootfs::packages_with_live_boot(b), ","), "vim")
end

#[test]
fn test_remove_apt_tooling_keeps_dpkg() is
    let root: string = testutil::tmpdir()
    testutil::put(root + "/usr/bin/apt-get", "x")
    testutil::put(root + "/usr/bin/apt", "x")
    testutil::put(root + "/usr/lib/apt/methods/http", "x")
    testutil::put(root + "/var/lib/dpkg/status", "Package: a\n")
    testutil::eq_s(rootfs::remove_apt_tooling(root), "")
    testutil::is_true(!fsx::lexists(root + "/usr/bin/apt-get"), "apt-get usuniety")
    testutil::is_true(!fsx::exists(root + "/usr/lib/apt"), "usr/lib/apt usuniety")
    testutil::is_true(fsx::exists(root + "/var/lib/dpkg/status"), "baza dpkg zostaje")
end
