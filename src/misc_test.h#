#[test]
fn test_toolchain_uses_cached_binaries_without_download() is
    let wd: string = testutil::tmpdir()
    let m: toolchain::Manager = toolchain::new_manager(wd)
    fsx::mkdir_p(m.tc_bin_dir)
    let names: [string] = ["debootstrap", "mksquashfs", "grub-mkrescue", "xorriso"]
    let mut i: int = 0
    while i < array_len(names) is
        testutil::put(m.tc_bin_dir + "/" + names[i], "#!/bin/sh\n")
        i += 1
    end
    testutil::eq_s(toolchain::prepare_all(m), "")
    testutil::eq_s(toolchain::bin_path(m, "debootstrap"), m.tc_bin_dir + "/debootstrap")
    testutil::contains(toolchain::env(m)[0], "toolchain/bin:")
end
