#[test]
fn test_sandbox_script_mounts_and_cleans() is
    let s: string = sandbox::mount_and_chroot_script("/r", ["apt-get", "install", "-y", "a b"])
    testutil::contains(s, "mount -t proc")
    testutil::contains(s, "mount --bind     /dev/pts")
    testutil::contains(s, "trap _cleanup EXIT")
    testutil::contains(s, "exec chroot \"$ROOTFS\" 'apt-get' 'install' '-y' 'a b'")
end

#[test]
fn test_sandbox_line_env_and_timeout() is
    let l: string = sandbox::unshare_line("/r", ["X=1"], 30, ["ls"])
    testutil::contains(l, "'DEBIAN_FRONTEND=noninteractive'")
    testutil::contains(l, "'X=1'")
    testutil::contains(l, "-s KILL 30")
    testutil::contains(l, "--mount --pid --fork --uts --kill-child")
    testutil::is_true(!string_contains(sandbox::unshare_line("/r", [], 0, ["ls"]), "timeout"), "bez limitu brak timeout")
end

#[test]
fn test_hkgen_defaults_and_origin() is
    let mut p: hkgen::HammerConfigParams = hkgen::empty_params()
    p.hc_os_name = "debian"
    p.hc_require_gpg = true
    p.hc_origin = "docker://ghcr.io/a/b:t"
    let out: string = hk::serialize(hkgen::generate(p))
    testutil::contains(out, "[sysroot]\n-> path => /")
    testutil::contains(out, "-> repo_path => /ostree/repo")
    testutil::contains(out, "-> osname => debian")
    testutil::contains(out, "-> require_gpg => true")
    testutil::contains(out, "[origin]\n-> refspec => docker://ghcr.io/a/b:t")
    testutil::is_true(!string_contains(hk::serialize(hkgen::generate(hkgen::empty_params())), "[origin]"), "bez origin brak sekcji")
end

#[test]
fn test_hkgen_written_file_parses_back() is
    let d: string = testutil::tmpdir()
    let mut p: hkgen::HammerConfigParams = hkgen::empty_params()
    p.hc_origin = "docker://x/y:z"
    fsx::mkdir_p(d + "/etc/hammer")
    testutil::eq_s(hkgen::write_hammer_config(d + "/etc/hammer/oci.hk", p), "")
    let r: hk::HkParse = hk::load_file(d + "/etc/hammer/oci.hk")
    testutil::eq_s(r.hp_err, "")
    testutil::eq_s(hk::as_string(hk::get_path(r.hp_doc, "origin.refspec")), "docker://x/y:z")
end

