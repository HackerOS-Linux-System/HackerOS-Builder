#[test]
fn test_fsx_path_helpers() is
    testutil::eq_s(fsx::clean("/a/b/../c//d/./"), "/a/c/d")
    testutil::eq_s(fsx::clean("a/../.."), "..")
    testutil::eq_s(fsx::clean(""), ".")
    testutil::eq_s(fsx::join("/x/", "/y"), "/x/y")
    testutil::eq_s(fsx::dirname("/a/b/c"), "/a/b")
    testutil::eq_s(fsx::dirname("file"), ".")
    testutil::eq_s(fsx::basename("/a/b/c/"), "c")
    testutil::eq_i(fsx::oct("755"), 493)
    testutil::eq_i(fsx::oct("4755"), 2541)
    testutil::eq_i(fsx::makedev(5, 1), 1281)
end

#[test]
fn test_mkdir_all_mode_applies_umask() is
    let d: string = testutil::tmpdir()
    testutil::eq_s(fsx::mkdir_all_mode(d + "/a/b", 511), "")
    testutil::eq_s(fsx::stat_mode_octal(d + "/a/b"), "755")
    shell("chmod 700 '" + d + "/a/b'")
    testutil::eq_s(fsx::mkdir_all_mode(d + "/a/b", 511), "")
    testutil::eq_s(fsx::stat_mode_octal(d + "/a/b"), "700")
end

#[test]
fn test_remove_all_refuses_root() is
    testutil::contains(fsx::remove_all("/"), "odmowa")
    testutil::contains(fsx::remove_all(""), "odmowa")
end

#[test]
fn test_ensure_dev_skeleton() is
    let root: string = testutil::tmpdir()
    let w: [string] = fsx::ensure_dev_skeleton(root)
    testutil::eq_s(fsx::stat_mode_octal(root + "/tmp"), "1777")
    testutil::is_true(fsx::is_dir(root + "/proc") && fsx::is_dir(root + "/sys") && fsx::is_dir(root + "/run"), "punkty montowania")
    if sysc::euid() == 0 is
        testutil::eq_i(array_len(w), 0)
        testutil::is_true(fsx::is_char_dev(root + "/dev/console") && fsx::is_char_dev(root + "/dev/null"), "wezly urzadzen")
    end
end

#[test]
fn test_proc_run_captures_output_and_code() is
    let r: proc::RunResult = proc::run(["sh", "-c", "echo out; echo err >&2; exit 3"])
    testutil::eq_i(r.rr_code, 3)
    testutil::eq_s(r.rr_stdout, "out\n")
    testutil::eq_s(r.rr_stderr, "err\n")
end

#[test]
fn test_proc_run_or_error() is
    testutil::eq_s(proc::run_or_error(["true"]), "")
    testutil::contains(proc::run_or_error(["sh", "-c", "echo boom >&2; exit 2"]), "kodem 2")
    testutil::contains(proc::run_or_error(["definitely-not-a-binary-xyz"]), "nie znaleziono programu")
end

#[test]
fn test_proc_quoting_is_injection_safe() is
    let d: string = testutil::tmpdir()
    let evil: string = "a'; touch " + d + "/pwned; echo '"
    proc::run(["echo", evil])
    testutil::is_true(!fsx::exists(d + "/pwned"), "argumenty sa cytowane")
end

#[test]
fn test_run_with_stdin() is
    let d: string = testutil::tmpdir()
    testutil::eq_s(proc::run_with_stdin("", "dane\n", ["sh", "-c", "cat > " + d + "/got"]), "")
    testutil::eq_s(fs_read(d + "/got"), "dane\n")
    testutil::contains(proc::run_with_stdin("", "x", ["sh", "-c", "exit 4"]), "exit status 4")
end

#[test]
fn test_job_counts_real_output_lines() is
    let j: proc::Job = proc::job_start_rc("printf 'I: Retrieving a\\nI: Retrieving b\\rI: Unpacking c\\nnoise\\n'")
    testutil::eq_i(proc::job_wait(j), 0)
    testutil::eq_i(proc::job_count(j, ["I: Retrieving ", "I: Unpacking "]), 3)
    proc::job_cleanup(j)
end

#[test]
fn test_job_failure_code_and_tail() is
    let r: track::TrackRes = track::run_line("echo line1; echo line2; exit 7", "x", 0, "u", ["line"], "t", "fail")
    testutil::eq_i(r.tk_rc, 7)
