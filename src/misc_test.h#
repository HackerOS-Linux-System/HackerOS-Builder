#[test]
fn test_strx_sort_and_helpers() is
    testutil::eq_s(array_join(strx::sort_strings(["b", "a10", "a2", "B"]), ","), "B,a10,a2,b")
    testutil::eq_s(array_join(strx::fields("  a \t b\nc "), ","), "a,b,c")
