pub fn is_retryable_transfer_err(msg: string) -> bool is
    let m: string = string_lower(msg)
    let needles: [string] = ["unexpected eof", "connection reset", "broken pipe", "timeout", "tls handshake", "i/o timeout", "eof", "temporary failure", "unexpected status code 429", "unexpected status code 500", "unexpected status code 502", "unexpected status code 503", "unexpected status code 504"]
    let mut i: int = 0
    while i < array_len(needles) is
        if string_contains(m, needles[i]) is return true end
        i += 1
    end
    return false
end

pub struct LayerDesc is
    pub ld_digest: string
    pub ld_size:   int
end

pub struct ManifestRes is
    pub mr_layers: [LayerDesc]
    pub mr_err:    string
end

fn get_manifest_body(reg: registry::Reg, ref: string) -> string is
    let url: string = registry::manifest_url(reg, ref)
    let r: registry::Resp = request_retry(reg, "GET", url, [registry::accept_manifests()], "", true, 120)
    if r.rs_err != "" is
        registry::resp_free(r)
        return "!" + r.rs_err
    end
    if r.rs_status != 200 is
        let e: string = registry::status_error("GET", url, r)
        registry::resp_free(r)
        return "!" + e
    end
    let body: string = registry::read_body(r)
    registry::resp_free(r)
    return body
end

;; Rozwiazuje manifest (w razie indeksu wybiera linux/amd64) do listy warstw.
fn resolve_layers(reg: registry::Reg, ref: string) -> ManifestRes is
    let none: [LayerDesc] = []
    let mut body: string = get_manifest_body(reg, ref)
    if string_starts_with(body, "!") is return ManifestRes { mr_layers: none, mr_err: string_slice(body, 1, string_len(body)) } end
    if jsonx::has(body, "manifests") && !jsonx::has(body, "layers") is
        let n: int = jsonx::array_len_at(body, "manifests")
        let mut chosen: string = ""
        let mut i: int = 0
        while i < n is
            let p: string = "manifests." + to_string(i)
            if jsonx::get(body, p + ".platform.os") == "linux" && jsonx::get(body, p + ".platform.architecture") == "amd64" && chosen == "" is
                chosen = jsonx::get(body, p + ".digest")
            end
            i += 1
        end
        if chosen == "" is
            return ManifestRes { mr_layers: none, mr_err: "no child with platform linux/amd64 in index " + reg.rg_repo + ":" + ref }
        end
        body = get_manifest_body(reg, chosen)
        if string_starts_with(body, "!") is return ManifestRes { mr_layers: none, mr_err: string_slice(body, 1, string_len(body)) } end
    end
    let ln: int = jsonx::array_len_at(body, "layers")
    if ln == 0 is return ManifestRes { mr_layers: none, mr_err: "manifest nie zawiera warstw" } end
    let mut layers: [LayerDesc] = []
    let mut k: int = 0
    while k < ln is
        let p2: string = "layers." + to_string(k)
        let sz: string = jsonx::get(body, p2 + ".size")
        layers = array_push(layers, LayerDesc { ld_digest: jsonx::get(body, p2 + ".digest"), ld_size: if sz == "" then 0 else str_to_int(sz) })
        k += 1
    end
    return ManifestRes { mr_layers: layers, mr_err: "" }
end

struct DlRes is
    dr_err: string
    dr_bar: prog::Bar
end

;; Pobiera blob do pliku (z paskiem postepu opartym na rozmiarze pliku) i weryfikuje sha256.
fn download_blob(reg: registry::Reg, digest: string, dest: string, size: int, bar: prog::Bar, base_done: int) -> DlRes is
    let mut b: prog::Bar = bar
    let url: string = registry::blob_url(reg, digest)
    let mut cmd: string = "curl -sS --connect-timeout 10 --speed-time 60 --speed-limit 1 -L"
    if reg.rg_insecure is cmd = cmd + " -k" end
    if reg.rg_cfg != "" is cmd = cmd + " -K " + proc::sq(reg.rg_cfg) end
    cmd = cmd + " -o " + proc::sq(dest) + " -w '%{{http_code}}' " + proc::sq(url)
    let job: proc::Job = proc::job_start_rc(cmd)
    while !proc::job_done(job) is
        b = prog::set(b, base_done + fsx::file_size_of(dest))
        sleep_ms(100)
    end
    let rc: int = proc::job_code(job)
    let log: string = string_trim(proc::read_file_or_empty(job.job_log))
    proc::job_cleanup(job)
    if rc != 0 is
        fsx::remove(dest)
        return DlRes { dr_err: "GET " + url + ": " + transport_msg(rc, log), dr_bar: b }
    end
    let code: string = if string_len(log) >= 3 then string_slice(log, string_len(log) - 3, string_len(log)) else log
    if code != "200" is
        fsx::remove(dest)
        return DlRes { dr_err: "GET " + url + ": unexpected status code " + code, dr_bar: b }
    end
    let actual: string = net::sha256_file(dest)
    let want: string = strx::trim_prefix(digest, "sha256:")
    if actual != want is
        fsx::remove(dest)
        return DlRes { dr_err: "suma sha256 warstwy " + digest + " nie zgadza sie: otrzymano sha256:" + actual, dr_bar: b }
    end
    b = prog::set(b, base_done + size)
    return DlRes { dr_err: "", dr_bar: b }
end

fn transport_msg(rc: int, log: string) -> string is
    if rc == 28 is return "i/o timeout: " + log end
    if rc == 18 is return "unexpected EOF: " + log end
    if rc == 56 || rc == 52 || rc == 55 is return "connection reset by peer / unexpected EOF: " + log end
    if rc == 35 || rc == 58 || rc == 60 is return "tls handshake error: " + log end
    if rc == 6 is return "temporary failure in name resolution: " + log end
    return log + " (curl " + to_string(rc) + ")"
end

;; Nakladanie warstwy: whiteouty (.wh.*) wykonane przed wypakowaniem, reszta przez tar (-m: mtime = teraz, jak w Go).
pub fn apply_layer(layer_file: string, dest: string) -> string is
    let names: [string] = fsx::non_empty_lines(shell("tar -tf " + proc::sq(layer_file) + " 2>/dev/null"))
    let mut i: int = 0
    while i < array_len(names) is
        let nm: string = names[i]
        i += 1
        let base: string = fsx::basename(nm)
        let dir: string = fsx::dirname(nm)
        if base == ".wh..wh..opq" is
            let target: string = fsx::join(dest, dir)
            if fsx::is_dir(target) is
                sysc::sh("find " + proc::sq(target) + " -mindepth 1 -maxdepth 1 -exec rm -rf {{}} + 2>/dev/null")
            end
        else if string_starts_with(base, ".wh.") is
            fsx::remove_all(fsx::join(fsx::join(dest, dir), strx::trim_prefix(base, ".wh.")))
        end
    end
    let owner: string = if sysc::euid() == 0 then "--same-owner" else "--no-same-owner"
    let se: string = proc::tmp_path("tarx")
    let rc: int = sysc::sh("tar -xf " + proc::sq(layer_file) + " -C " + proc::sq(dest) + " --numeric-owner " + owner + " -p -m --exclude='.wh.*' 2>" + proc::sq(se))
    let errtxt: string = proc::read_file_or_empty(se)
    fsx::remove(se)
    if rc == 0 is return "" end
    let lines: [string] = fsx::non_empty_lines(errtxt)
    let mut fatal: string = ""
    let mut j: int = 0
    while j < array_len(lines) is
        let l: string = lines[j]
        j += 1
        if string_contains(l, "Cannot mknod") is
            ui::warn("Nie mozna utworzyc wezla urzadzenia: " + l)
        else if string_contains(l, "Exiting with failure status") || string_contains(l, "Cannot change ownership") && sysc::euid() != 0 is
            ;; pomijamy (jak ignorowanie bledow uprawnien w Go)
        else if fatal == "" is
            fatal = l
        end
    end
    if fatal != "" is return "czytanie tar: " + fatal end
    return ""
end

fn pull_once(r: registry::RegRef, token: string, insecure: bool, dest: string) -> string is
    let lg: registry::LoginRes = registry::login(r, token, "pull", insecure)
    if lg.lg_err != "" is return "pobieranie " + r.rf_orig + " nie powiodlo sie: " + lg.lg_err end
    let reg: registry::Reg = lg.lg_reg
    let mr: ManifestRes = resolve_layers(reg, r.rf_ref)
    if mr.mr_err != "" is
        registry::logout(reg)
        return "pobieranie " + r.rf_orig + " nie powiodlo sie: " + mr.mr_err
    end
    let re: string = fsx::remove_all(dest)
    if re != "" is
        registry::logout(reg)
        return "czyszczenie " + dest + ": " + re
    end
    let me: string = fsx::mkdir_p(dest)
    if me != "" is
        registry::logout(reg)
        return "tworzenie " + dest + ": " + me
    end
    let layers: [LayerDesc] = mr.mr_layers
    let mut total: int = 0
    let mut i: int = 0
    while i < array_len(layers) is
        total = total + layers[i].ld_size
        i += 1
    end
    ui::info("Rozpakowywanie " + to_string(array_len(layers)) + " warstw(y) (razem " + ui::format_bytes(total) + ")...")
    let mut bar: prog::Bar = prog::new("pull OCI", total, "bajtow")
    let tmp: string = proc::tmp_path("pull")
    fsx::mkdir_p(tmp)
    let mut done: int = 0
    let mut k: int = 0
    while k < array_len(layers) is
        let lf: string = fsx::join(tmp, "layer-" + to_string(k) + ".blob")
        let dr: DlRes = download_blob(reg, layers[k].ld_digest, lf, layers[k].ld_size, bar, done)
        bar = dr.dr_bar
        if dr.dr_err != "" is
            bar = prog::fail(bar, "warstwa " + to_string(k + 1) + "/" + to_string(array_len(layers)))
            fsx::remove_all(tmp)
            registry::logout(reg)
            return "rozpakowywanie warstwy " + to_string(k + 1) + "/" + to_string(array_len(layers)) + ": " + dr.dr_err
        end
        let ae: string = apply_layer(lf, dest)
        fsx::remove(lf)
        if ae != "" is
            bar = prog::fail(bar, "warstwa " + to_string(k + 1) + "/" + to_string(array_len(layers)))
            fsx::remove_all(tmp)
            registry::logout(reg)
            return "rozpakowywanie warstwy " + to_string(k + 1) + "/" + to_string(array_len(layers)) + ": " + ae
        end
        done = done + layers[k].ld_size
        k += 1
    end
    fsx::remove_all(tmp)
    registry::logout(reg)
    bar = prog::finish(bar)
    return ""
end

;; PullAndUnpack: "" = OK
pub fn pull_and_unpack(repository: string, tag: string, token: string, dest: string, insecure: bool) -> string is
    let ref_str: string = repository + ":" + tag
    let r: registry::RegRef = registry::parse_reference(ref_str)
    if r.rf_err != "" is return "nieprawidlowa referencja obrazu " + ui::quote(ref_str) + ": " + r.rf_err end
    let mut last_err: string = ""
    let mut attempt: int = 1
    while attempt <= max_pull_attempts() is
        if attempt > 1 is
            ui::warn("Sciaganie obrazu nie powiodlo sie (proba " + to_string(attempt - 1) + "/" + to_string(max_pull_attempts()) + "): " + last_err + " -- ponawiam za 3s...")
            sleep_ms(retry_backoff_ms())
        end
        ui::info("Sciagam obraz OCI: " + ref_str + " (proba " + to_string(attempt) + "/" + to_string(max_pull_attempts()) + ")")
        let e: string = pull_once(r, token, insecure, dest)
        if e == "" is
            ui::info("Obraz rozpakowany do " + dest)
            return ""
        end
        last_err = e
        if !is_retryable_transfer_err(e) is return e end
        attempt += 1
    end
    return "sciaganie obrazu " + ref_str + " nie powiodlo sie po " + to_string(max_pull_attempts()) + " probach (ostatni blad): " + last_err
end

fn retry_backoff_ms() -> int is
    let v: string = env_get("HACKEROS_PULL_BACKOFF_MS")
    if v != "" is return str_to_int(v) end
    return 3000
end
