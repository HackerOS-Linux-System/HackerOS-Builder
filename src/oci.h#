pub struct Image is
    pub im_dir:        string
    pub im_layers:     [string]
    pub im_digests:    [string]
    pub im_diffids:    [string]
    pub im_sizes:      [int]
    pub im_cfg_path:   string
    pub im_cfg_digest: string
    pub im_cfg_size:   int
    pub im_man_path:   string
    pub im_man_size:   int
end

pub struct ImageRes is
    pub ir_img: Image
