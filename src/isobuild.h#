;; ============================ ARCH ============================
fn go_arch_of_host() -> string is
    let m: string = string_trim(shell("uname -m"))
    if m == "x86_64" || m == "amd64" is return "amd64" end
    if m == "aarch64" || m == "arm64" is return "arm64" end
    if string_starts_with(m, "armv") is return "arm" end
    if m == "i386" || m == "i686" || m == "i586" is return "386" end
    if m == "mips" is return "mips" end
    if m == "mips64" is return "mips64le" end
    if m == "ppc64le" is return "ppc64le" end
    if m == "riscv64" is return "riscv64" end
    if m == "s390x" is return "s390x" end
    return ""
end

fn arch_to_debian(go_arch: string) -> string is
    if go_arch == "amd64" is return "amd64" end
    if go_arch == "arm64" is return "arm64" end
    if go_arch == "arm" is return "armhf" end
    if go_arch == "386" is return "i386" end
    if go_arch == "mips" is return "mipsel" end
    if go_arch == "mips64le" is return "mips64el" end
    if go_arch == "ppc64le" is return "ppc64el" end
    if go_arch == "riscv64" is return "riscv64" end
    if go_arch == "s390x" is return "s390x" end
    return ""
end

pub fn warn_if_foreign_arch(arch: string) is
    if arch == "" is return end
    let host: string = arch_to_debian(go_arch_of_host())
    if host == "" || arch == host is return end
    ui::warn("[release] -> arch=" + ui::quote(arch) + " rozni sie od architektury hosta budujacego (" + ui::quote(host) + ") -- grub-mkrescue uzyje modulow GRUB Z HOSTA (hackeros-builder nie przekazuje jawnego \"-d <platforma>\"), co dla INNEJ architektury zazwyczaj oznacza ISO ktore NIE WSTANIE na docelowym sprzecie, chyba ze host ma recznie zainstalowane wielo-architekturowe pakiety GRUB (np. grub-efi-" + arch + "-bin) I samodzielnie skonfigurowany odpowiedni --target. Pelne wsparcie cross-arch ISO to osobna pozycja w ROADMAP (README.md) -- na razie [release] -> arch niezawodnie wplywa TYLKO na sam rootfs (debootstrap), nie na bootowalnosc finalnego ISO.")
end

;; ============================ NIEZMIENNOSC ============================
fn write_rel(rootfs: string, rel: string, content: string, mode: int) -> string is
    return fsx::write_file_p(fsx::join(rootfs, rel), content, mode)
end

pub fn write_immutability(rootfs: string) -> string is
    let e1: string = write_rel(rootfs, "usr/sbin/hackeros-immutable", installer_assets::immutable_script(), 493)
    if e1 != "" is return e1 end
    let e2: string = write_rel(rootfs, "etc/systemd/system/hackeros-immutable.service", installer_assets::immutable_service_unit(), 420)
    if e2 != "" is return e2 end
    let wants: string = fsx::join(rootfs, "etc/systemd/system/sysinit.target.wants")
    let me: string = fsx::mkdir_p(wants)
    if me != "" is return me end
    let link: string = fsx::join(wants, "hackeros-immutable.service")
    fsx::remove(link)
    let se: string = fsx::symlink_force("/etc/systemd/system/hackeros-immutable.service", link)
    if se != "" is return "wlaczanie hackeros-immutable.service: " + se end
    let ue: string = fsx::mkdir_p(fsx::join(rootfs, "usr/local"))
    if ue != "" is return ue end
    if fsx::exists(fsx::join(rootfs, "usr/bin/hammer")) is
        let h1: string = write_rel(rootfs, "hammer/db/.immutable-enabled", "1\n", 420)
        if h1 != "" is return h1 end
        let h2: string = write_rel(rootfs, "hammer/db/.immutable-backend", "remount\n", 420)
        if h2 != "" is return h2 end
    end
    return ""
end

;; ============================ BRANDING ============================
fn branding_source_dirs(project_dir: string) -> [string] is
    if project_dir == "" is return [] end
    let cfg: string = fsx::join(project_dir, "config")
    let mut dirs: [string] = []
    let incs: [string] = ["includes.chroot_after_packages", "includes.chroot", "includes.chroot_before_packages"]
    let mut i: int = 0
    while i < array_len(incs) is
        dirs = array_push(dirs, fsx::join(fsx::join(fsx::join(fsx::join(fsx::join(cfg, incs[i]), "etc"), "calamares"), "branding"), "debian"))
        i += 1
    end
    return array_push(dirs, fsx::join(cfg, "installer-branding"))
end

;; png.DecodeConfig: sygnatura PNG + poprawny naglowek IHDR. "" = OK, inaczej opis bledu.
fn png_config_error(path: string) -> string is
    let hex: string = string_trim(shell("od -An -tx1 -N24 " + proc::sq(path) + " 2>/dev/null | tr -d ' \\n'"))
    if string_len(hex) < 16 || string_slice(hex, 0, 16) != "89504e470d0a1a0a" is return "png: invalid format: not a PNG file" end
    if string_len(hex) < 48 is return "unexpected EOF" end
    if string_slice(hex, 8 * 2 + 8, 8 * 2 + 16) != "49484452" is return "png: invalid format: not a PNG file" end
    return ""
end

;; Zwraca pary "nazwa_docelowa=sciezka_zrodla" dla znalezionych plikow brandingu projektu.
fn load_project_branding(project_dir: string) -> [string] is
    let mut out: [string] = []
    let pairs: [string] = ["debian-logo.png:logo.png", "welcome.png:welcome.png"]
    let mut i: int = 0
    while i < array_len(pairs) is
        let pr: [string] = string_split(pairs[i], ":")
        i += 1
        let mut found: bool = false
        let dirs: [string] = branding_source_dirs(project_dir)
        let mut d: int = 0
        while d < array_len(dirs) && !found is
            let path: string = fsx::join(dirs[d], pr[0])
            d += 1
            if file_exists(path) is
                let pe: string = png_config_error(path)
                if pe != "" is
                    ui::warn("branding: " + path + " nie jest poprawnym PNG (" + pe + ") -- pomijam")
                else is
                    ui::info("  branding instalatora: " + path + " -> " + pr[1])
                    out = array_push(out, pr[1] + "=" + path)
                    found = true
                end
            end
        end
        if !found is
            ui::warn("branding: nie znaleziono " + pr[0] + " w projekcie (szukano w " + proc::format_args(dirs) + ") -- uzywam obrazu generowanego")
        end
    end
    return out
end

fn write_b64_png(b64: string, dest: string) -> string is
    let tmp: string = proc::tmp_path("b64")
    fs_write(tmp, b64)
    let rc: int = sysc::sh("base64 -d " + proc::sq(tmp) + " > " + proc::sq(dest) + " 2>/dev/null")
    fsx::remove(tmp)
    if rc != 0 is return "base64 -d zakonczone kodem " + to_string(rc) end
    if !fsx::set_mode(dest, 420) is return "chmod " + dest + ": blad" end
    return ""
end

