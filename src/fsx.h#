pub fn exists(path: string) -> bool is return file_exists(path) || dir_exists(path) end
pub fn is_dir(path: string) -> bool is return dir_exists(path) end
pub fn is_symlink(path: string) -> bool is return sysc::sh("test -L " + proc::sq(path)) == 0 end
pub fn lexists(path: string) -> bool is return exists(path) || is_symlink(path) end
pub fn is_char_dev(path: string) -> bool is return sysc::sh("test -c " + proc::sq(path)) == 0 end

pub fn mkdir_p(path: string) -> string is
    let rc: int = sysc::sh("mkdir -p " + proc::sq(path) + " 2>/dev/null")
    if rc != 0 is return "mkdir " + path + ": blad (kod " + to_string(rc) + ")" end
    return ""
end

pub fn mkdir_mode(path: string, mode: string) -> string is
    let rc: int = sysc::sh("mkdir -p -m " + mode + " " + proc::sq(path) + " 2>/dev/null")
    if rc != 0 is return "mkdir " + path + ": blad (kod " + to_string(rc) + ")" end
    return ""
end

;; os.RemoveAll (idempotentne; odmawia dla "" i "/")
pub fn remove_all(path: string) -> string is
    if path == "" || path == "/" is return "odmowa usuniecia \"" + path + "\"" end
    let rc: int = sysc::sh("rm -rf " + proc::sq(path) + " 2>/dev/null")
    if rc != 0 is return "nie mozna usunac " + path end
    return ""
end

pub fn remove(path: string) is
    sysc::sh("rm -f " + proc::sq(path) + " 2>/dev/null")
end

pub fn set_mode(path: string, mode: int) -> bool is
    return sysc::make_chmod(path, mode) == 0
end

pub fn dirname(path: string) -> string is
    let mut p: string = path
    while string_len(p) > 1 && string_ends_with(p, "/") is p = string_slice(p, 0, string_len(p) - 1) end
    let mut cut: int = -1
    let mut i: int = 0
    while i < string_len(p) is
        if string_at(p, i) == "/" is cut = i end
        i += 1
    end
    if cut < 0 is return "." end
    if cut == 0 is return "/" end
    return string_slice(p, 0, cut)
end

pub fn basename(path: string) -> string is
    let mut p: string = path
    while string_len(p) > 1 && string_ends_with(p, "/") is p = string_slice(p, 0, string_len(p) - 1) end
    let mut cut: int = -1
    let mut i: int = 0
    while i < string_len(p) is
        if string_at(p, i) == "/" is cut = i end
        i += 1
    end
    if cut < 0 is return p end
    return string_slice(p, cut + 1, string_len(p))
end

;; filepath.Join: laczy i czysci (bez ".." rozwiazywania poza podstawowym)
pub fn join(a: string, b: string) -> string is
    if a == "" is return b end
    if b == "" is return a end
    let mut x: string = a
    while string_len(x) > 1 && string_ends_with(x, "/") is x = string_slice(x, 0, string_len(x) - 1) end
    let mut y: string = b
    while string_starts_with(y, "/") is y = string_slice(y, 1, string_len(y)) end
    if x == "/" is return "/" + y end
    return x + "/" + y
end

;; filepath.Abs
pub fn abs(path: string) -> string is
    if string_starts_with(path, "/") is return clean(path) end
    return clean(getcwd() + "/" + path)
end

;; filepath.Clean (./ , //, .., koncowy /)
pub fn clean(path: string) -> string is
    if path == "" is return "." end
    let rooted: bool = string_starts_with(path, "/")
    let parts: [string] = string_split(path, "/")
    let mut stack: [string] = []
    let mut i: int = 0
    while i < array_len(parts) is
        let p: string = parts[i]
        i += 1
        if p == "" || p == "." is
            ;; pomijamy
        else if p == ".." is
            if array_len(stack) > 0 && stack[array_len(stack) - 1] != ".." is
                stack = array_slice(stack, 0, array_len(stack) - 1)
            else if !rooted is
                stack = array_push(stack, "..")
            end
        else is
            stack = array_push(stack, p)
        end
    end
    let body: string = array_join(stack, "/")
    if rooted is return "/" + body end
    if body == "" is return "." end
    return body
end

;; filepath.EvalSymlinks / readlink -f
pub fn real_path(path: string) -> string is
    let r: string = string_trim(shell("readlink -f " + proc::sq(path) + " 2>/dev/null"))
    if r == "" is return path end
    return r
end

pub fn readlink(path: string) -> string is
    return string_trim(shell("readlink " + proc::sq(path) + " 2>/dev/null"))
end

pub fn file_size_of(path: string) -> int is
    let t: string = string_trim(shell("stat -c %s " + proc::sq(path) + " 2>/dev/null"))
    if t == "" is return 0 end
    return str_to_int(t)
end

;; Lstat: typ i prawa, np. "directory 755"
pub fn stat_mode_octal(path: string) -> string is
    return string_trim(shell("stat -c %a " + proc::sq(path) + " 2>/dev/null"))
end

;; Nazwy w katalogu, posortowane bajtowo (os.ReadDir). Pusta lista dla brakujacego katalogu.
pub fn list_dir_sorted(dir: string) -> [string] is
    if !dir_exists(dir) is return [] end
    let out: string = shell("LC_ALL=C ls -1A " + proc::sq(dir) + " 2>/dev/null")
    return non_empty_lines(out)
end

pub fn non_empty_lines(text: string) -> [string] is
    let parts: [string] = string_split(text, "\n")
    let mut res: [string] = []
    let mut i: int = 0
    while i < array_len(parts) is
        if parts[i] != "" is res = array_push(res, parts[i]) end
        i += 1
    end
    return res
end

;; filepath.Glob dla wzorca "<dir>/<prefix>*" - pelne sciezki, posortowane.
pub fn glob_prefix(dir: string, prefix: string) -> [string] is
    if !dir_exists(dir) is return [] end
    let out: string = shell("find " + proc::sq(dir) + " -mindepth 1 -maxdepth 1 -name " + proc::sq(prefix + "*") + " 2>/dev/null | LC_ALL=C sort")
    return non_empty_lines(out)
end

;; Zapis pliku z DOKLADNYMI prawami (omija umask) - odpowiednik os.WriteFile + Chmod.
pub fn write_file(path: string, content: string, mode: int) -> string is
    if is_symlink(path) is remove(path) end
    if !fs_write(path, content) is return "zapis " + path + ": blad" end
    if !set_mode(path, mode) is return "chmod " + path + ": blad" end
    return ""
end

;; Zapis z automatycznym utworzeniem katalogu nadrzednego.
pub fn write_file_p(path: string, content: string, mode: int) -> string is
    let e: string = mkdir_p(dirname(path))
    if e != "" is return e end
    return write_file(path, content, mode)
end

;; copyFile z rootfs/builder.go: usuwa symlink docelowy, kopiuje tresc, ustawia prawa.
pub fn copy_file(src: string, dst: string, mode: int) -> string is
    let e: string = mkdir_p(dirname(dst))
    if e != "" is return e end
    if is_symlink(dst) is remove(dst) end
    let rc: int = sysc::sh("cat " + proc::sq(src) + " > " + proc::sq(dst) + " 2>/dev/null")
    if rc != 0 is return "kopiowanie " + src + " -> " + dst + ": blad" end
    if !set_mode(dst, mode) is return "chmod " + dst + ": blad" end
    return ""
end

;; Symlink (nadpisuje istniejacy wpis)
pub fn symlink_force(target: string, path: string) -> string is
    remove(path)
    if sysc::make_symlink(target, path) != 0 is
        return "symlink " + path + " -> " + target + ": blad"
    end
    return ""
end

;; Mknod z util/devnode.go. kind: "c" | "b" | "p". Wymaga roota.
pub fn makedev(major: int, minor: int) -> int is
    return (major % 4096) * 256 + (minor % 256) + ((minor / 256) * 4096 * 256) + ((major / 4096) * 4294967296 * 4096)
end

pub fn make_node(path: string, kind: string, perm: int, major: int, minor: int) -> string is
    let e: string = mkdir_p(dirname(path))
    if e != "" is return e end
    if lexists(path) is remove(path) end
    let bits: int = if kind == "c" then 8192 else (if kind == "b" then 24576 else 4096)
    if sysc::make_mknod(path, bits + perm, makedev(major, minor)) != 0 is
        return "mknod " + path + ": operation not permitted"
    end
    if !set_mode(path, perm) is return "chmod " + path + ": blad" end
    return ""
end

;; EnsureDevSkeleton: katalogi punktow montowania + podstawowe wezly /dev. Zwraca ostrzezenia.
pub fn ensure_dev_skeleton(rootfs: string) -> [string] is
    let mut warnings: [string] = []
    let dirs: [string] = ["dev:755", "proc:555", "sys:555", "run:755", "tmp:1777", "mnt:755", "media:755"]
    let mut i: int = 0
    while i < array_len(dirs) is
        let parts: [string] = string_split(dirs[i], ":")
        let p: string = join(rootfs, parts[0])
        let e: string = mkdir_mode(p, parts[1])
        if e != "" is
            warnings = array_push(warnings, "mkdir " + parts[0] + ": " + e)
        else if parts[0] == "tmp" is
            sysc::sh("chmod 1777 " + proc::sq(p))
        end
        i += 1
    end
    let nodes: [string] = ["console:600:5:1", "null:666:1:3", "zero:666:1:5", "full:666:1:7", "random:666:1:8", "urandom:666:1:9", "tty:666:5:0"]
    let mut j: int = 0
    while j < array_len(nodes) is
        let f: [string] = string_split(nodes[j], ":")
        let p: string = join(join(rootfs, "dev"), f[0])
        if !is_char_dev(p) is
            let perm: int = oct(f[1])
            let err: string = make_node(p, "c", perm, str_to_int(f[2]), str_to_int(f[3]))
            if err != "" is warnings = array_push(warnings, err) end
        end
        j += 1
    end
    return warnings
end

;; "755" -> 493
pub fn oct(s: string) -> int is
    let mut n: int = 0
    let mut i: int = 0
    while i < string_len(s) is
        n = n * 8 + str_to_int(string_at(s, i))
        i += 1
    end
    return n
end

;; Suma rozmiarow zwyklych plikow (filepath.Walk + IsRegular)
pub fn tree_size(root: string) -> int is
    let t: string = string_trim(shell("find " + proc::sq(root) + " -type f -printf '%s\\n' 2>/dev/null | awk '{{s+=$1}} END{{print s+0}}'"))
    if t == "" is return 0 end
    return str_to_int(t)
end

;; umask procesu (liczba) - do emulacji os.MkdirAll(path, mode)
pub fn current_umask() -> int is
    let t: string = string_trim(shell("umask"))
    if t == "" is return 18 end
    return oct(t)
end

;; os.MkdirAll(path, mode): tworzy brakujace katalogi z prawami mode & ~umask (istniejace nietkniete).
pub fn mkdir_all_mode(path: string, mode: int) -> string is
    if exists(path) is return "" end
    let parent: string = dirname(path)
    if parent != path && !exists(parent) is
        let e: string = mkdir_all_mode(parent, 493)
        if e != "" is return e end
    end
    let eff: int = mode - (mode % 8) + 0
    let masked: int = and_not(mode, current_umask())
    if sysc::sh("mkdir " + proc::sq(path) + " 2>/dev/null") != 0 is return "mkdir " + path + ": blad" end
    if !set_mode(path, masked) is return "chmod " + path + ": blad" end
    return ""
end

;; a & ~b na liczbach 0..4095
pub fn and_not(a: int, b: int) -> int is
    let mut r: int = 0
    let mut bit: int = 1
    let mut x: int = a
    let mut y: int = b
    while x > 0 is
        let xb: int = x % 2
        let yb: int = y % 2
        if xb == 1 && yb == 0 is r = r + bit end
        x = x / 2
        y = y / 2
        bit = bit * 2
    end
    return r
end
