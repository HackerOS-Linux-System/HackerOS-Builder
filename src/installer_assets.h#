pub fn installer_bootfix_script() -> string is
    return "#!/bin/sh
LOG=/var/log/hackeros-bootfix.log
exec >>\"$LOG\" 2>&1
echo \"== hackeros-bootfix $(date)\"
CFG=/boot/grub/grub.cfg
mkdir -p /boot/grub

if [ ! -f /etc/default/grub ]; then
    cat > /etc/default/grub <<'EOF'
GRUB_DEFAULT=0
GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR=\"HackerOS\"
GRUB_CMDLINE_LINUX_DEFAULT=\"quiet\"
GRUB_CMDLINE_LINUX=\"\"
EOF
fi
if grep -q '^GRUB_DISTRIBUTOR=' /etc/default/grub; then
    sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR=\"HackerOS\"/' /etc/default/grub
else
    echo 'GRUB_DISTRIBUTOR=\"HackerOS\"' >> /etc/default/grub
fi
# Parametry live nie moga trafic do zainstalowanego systemu.
sed -i 's/ *boot=live//; s/ *live-media-path=[^ \"]*//' /etc/default/grub

has_entry() {{ [ -s \"$CFG\" ] && grep -q '^[[:space:]]*menuentry ' \"$CFG\" && grep -q '^[[:space:]]*linux' \"$CFG\"; }}

KVER=$(ls /boot/vmlinuz-* 2>/dev/null | sed 's|/boot/vmlinuz-||' | sort -V | tail -1)
echo \"jadro: ${{KVER:-BRAK}}\"
if [ -n \"$KVER\" ] && [ ! -e \"/boot/initrd.img-$KVER\" ]; then
    echo \"brak initrd dla $KVER -- update-initramfs\"
    update-initramfs -c -k \"$KVER\"
fi

has_entry || grub-mkconfig -o \"$CFG\"
has_entry || GRUB_DISABLE_OS_PROBER=true grub-mkconfig -o \"$CFG\"

ROOT_UUID=$(grub-probe --target=fs_uuid / 2>/dev/null)
[ -n \"$ROOT_UUID\" ] || ROOT_UUID=$(awk '$2==\"/\" && $1 ~ /^UUID=/ {{sub(\"UUID=\",\"\",$1); print $1; exit}}' /etc/fstab)
echo \"root uuid: ${{ROOT_UUID:-BRAK}}\"

if ! has_entry && [ -n \"$KVER\" ] && [ -n \"$ROOT_UUID\" ]; then
    echo \"grub-mkconfig nie dal wpisu -- generuje grub.cfg recznie\"
    INITRD=\"\"
    [ -e \"/boot/initrd.img-$KVER\" ] && INITRD=\"    initrd /boot/initrd.img-$KVER\"
    cat > \"$CFG\" <<EOF
set default=0
set timeout=5
menuentry \"HackerOS\" {{
    insmod part_gpt
    insmod part_msdos
    insmod ext2
    search --no-floppy --fs-uuid --set=root $ROOT_UUID
    linux /boot/vmlinuz-$KVER root=UUID=$ROOT_UUID ro quiet
$INITRD
}}
EOF
fi

# Zapasowe grub.cfg na ESP (gdy obraz EFI szuka konfiguracji obok siebie).
if [ -d /boot/efi/EFI ] && [ -n \"$ROOT_UUID\" ]; then
    for d in /boot/efi/EFI/*; do
        [ -d \"$d\" ] || continue
        if [ ! -f \"$d/grub.cfg\" ]; then
            printf 'search.fs_uuid %s root\\nset prefix=($root)/boot/grub\\nconfigfile $prefix/grub.cfg\\n' \"$ROOT_UUID\" > \"$d/grub.cfg\"
            echo \"stub ESP: $d/grub.cfg\"
        fi
    done
fi

if has_entry; then
    echo \"OK: $CFG ma wpis z jadrem\"
    exit 0
fi
echo \"BLAD: nie udalo sie wygenerowac grub.cfg z wpisem jadra\"
exit 1
"
end

pub fn installer_diag_script() -> string is
    return "#!/bin/sh
OUT=/root/installer-diag.txt
{{
echo \"### czas: $(date)  cmdline: $(cat /proc/cmdline)\"
echo
echo \"### procesy (Xorg/openbox/calamares/xinit/dbus)\"
ps -eo pid,etime,stat,args | grep -E 'Xorg|openbox|calamares|xinit|dbus-launch|kpmcore' | grep -v grep
echo
echo \"### stan uslugi\"
systemctl is-active hackeros-installer 2>&1
systemctl status hackeros-installer --no-pager -l 2>&1 | tail -n 15
echo
echo \"### log sesji (bez halasu xkbcomp)\"
grep -v -E 'xkbcomp|Warning:|^> |^>$|Using F23|Using last definition|AIGLX' /var/log/hackeros-installer.log 2>&1 | tail -n 40
echo
echo \"### Calamares: bledy/ostrzezenia (ostatnie 40)\"
grep -n -i -E 'error|fatal|fail|cannot|could not|missing|not found|bad config|abort|crash|segfault|warning' /var/log/hackeros-installer-calamares.log 2>&1 | tail -n 40
echo
echo \"### Calamares: ostatnie 40 linii logu\"
tail -n 40 /var/log/hackeros-installer-calamares.log 2>&1
echo
echo \"### urzadzenia wejscia: jadro i X\"
grep -E '^N: Name|^H: Handlers' /proc/bus/input/devices 2>&1
grep -E 'Using input driver|input device|libinput|evdev|XINPUT|No input driver' /var/log/Xorg.0.log 2>&1 | tail -n 25
udevadm info --export-db 2>/dev/null | grep -c 'ID_INPUT_MOUSE=1\\|ID_INPUT_TOUCHPAD=1' | sed 's/^/urzadzen mysz\\/touchpad w udev: /'
echo
echo \"### Xorg: (EE) i istotne (WW)\"
grep -E '\\(EE\\)|\\(WW\\)' /var/log/Xorg.0.log 2>&1 | grep -v -i -E 'xkb|firmware|fbdev|vesa' | tail -n 25
echo
echo \"### branding / konfiguracja\"
ls -la /etc/calamares/branding/hackeros/ /etc/calamares/modules/ 2>&1
echo
echo \"### dziennik uslugi (ostatnie 25)\"
journalctl -b -u hackeros-installer --no-pager 2>&1 | tail -n 25
}} 2>&1 | tee \"$OUT\"
